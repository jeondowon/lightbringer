Assets/Art/Characters/*/Rigged/*_Skinned.asset filter=lfs diff=lfs merge=lfs -text
Assets/Art/Characters/*/FaceRepair/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/Art/Characters/*/ShadowHood/*.asset filter=lfs diff=lfs merge=lfs -text
