/* Lightbringer desktop HUD. Palette follows the character sheet: navy panels, gold trim, ivory text.
   The view code only depends on the class names. Battle HUD art: Assets/UI/Art/Hud_*.png
   (Lightbringer/UI/Build Battle HUD Art). */

/* ---------- Shared ---------- */

.lb-panel {
    background-color: rgba(12, 18, 34, 0.78);
    border-width: 1px;
    border-color: rgba(219, 174, 90, 0.7);
    border-radius: 6px;
    padding: 6px 10px;
}

.lb-caption {
    font-size: 13px;
    color: rgba(238, 232, 219, 0.7);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lb-bar {
    height: 18px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.25);
    overflow: hidden;
    margin: 2px 0;
}

.lb-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
}

.lb-bar-gloss {
    display: none;
}

.lb-bar-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 250, 240);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

/* ---------- Battle HUD frame ---------- */

.lb-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(244, 238, 226);
    font-size: 16px;
}

.lb-hud Label {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* Darkens the ground behind the command bar so cards and orbs stay readable on bright grass. */
.lb-hud-vignette {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 300px;
    background-image: url("Art/Prep_Fade.png");
    background-size: 100% 100%;
    opacity: 0.5;
}

.lb-hud-panel {
    background-image: url("Art/Hud_Panel.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    padding: 8px 16px;
}

.lb-hud-frame {
    background-image: url("Art/Hud_FramePanel.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 14px 18px 14px 18px;
}

.lb-hud-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.lb-hud-title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: rgb(244, 212, 140);
}

.lb-hud-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    background-size: contain;
}

.lb-hud-icon--ally { background-image: url("Art/Hud_IconAlly.png"); }
.lb-hud-icon--enemy { background-image: url("Art/Hud_IconEnemy.png"); }
.lb-hud-icon--wave { background-image: url("Art/Hud_IconWave.png"); }
.lb-hud-icon--castle { background-image: url("Art/Hud_IconCastle.png"); }
.lb-hud-icon--food { background-image: url("Art/Growth_FoodProduction.png"); }

.lb-keycap {
    flex-shrink: 0;
    min-width: 24px;
    height: 24px;
    padding: 0 7px 2px 7px;
    align-items: center;
    justify-content: center;
    background-image: url("Art/Hud_Keycap.png");
    -unity-slice-left: 10;
    -unity-slice-right: 10;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
}

.lb-keycap-text {
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 244, 248);
}

/* ---------- Gauges ---------- */

.lb-hud .lb-bar {
    height: 18px;
    margin: 2px 0;
    border-width: 3px;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Art/Hud_BarFrame.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    overflow: hidden;
}

.lb-hud .lb-bar-fill {
    border-radius: 2px;
    background-image: url("Art/Hud_BarFill.png");
    background-size: 100% 100%;
    transition-property: width;
    transition-duration: 0.15s;
}

.lb-hud .lb-bar-gloss {
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("Art/Hud_BarGloss.png");
    background-size: 100% 100%;
}

.lb-hud .lb-bar-text {
    font-size: 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.lb-bar--hp .lb-bar-fill { -unity-background-image-tint-color: rgb(228, 58, 60); }
.lb-bar--mana .lb-bar-fill { -unity-background-image-tint-color: rgb(66, 134, 255); }
.lb-bar--food .lb-bar-fill { -unity-background-image-tint-color: rgb(244, 182, 58); }
.lb-bar--ally .lb-bar-fill { -unity-background-image-tint-color: rgb(84, 150, 244); }
.lb-bar--enemy .lb-bar-fill { -unity-background-image-tint-color: rgb(214, 52, 64); }
.lb-bar--boss .lb-bar-fill { -unity-background-image-tint-color: rgb(206, 36, 72); }
.lb-hud .lb-bar--shielded .lb-bar-fill { -unity-background-image-tint-color: rgb(160, 104, 255); }
.lb-hud .lb-bar--shielded .lb-bar-text { color: rgb(236, 220, 255); }

/* ---------- Top bar ---------- */

.lb-top {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}

.lb-top-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 20px;
}

.lb-stage {
    margin: 0;
    padding: 0;
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 224, 150);
}

.lb-divider {
    width: 1px;
    height: 26px;
    margin: 0 14px;
    background-color: rgba(219, 174, 90, 0.4);
}

.lb-fronts {
    flex-direction: row;
    align-items: center;
}

.lb-front {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
    padding: 3px 12px 3px 3px;
    border-radius: 17px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

.lb-front-number {
    width: 26px;
    height: 26px;
    margin: 0 8px 0 0;
    padding: 0;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.45);
    background-color: rgb(16, 22, 40);
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(238, 232, 219);
}

.lb-front-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.lb-front-allies, .lb-front-enemies {
    min-width: 14px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.lb-front-allies {
    margin-right: 10px;
    color: rgb(168, 210, 255);
}

.lb-front-enemies {
    color: rgb(255, 146, 146);
}

.lb-front--contested {
    background-color: rgba(214, 150, 50, 0.2);
}

.lb-front--danger {
    background-color: rgba(196, 36, 50, 0.5);
    border-color: rgb(255, 112, 112);
}

.lb-front--selected {
    border-color: rgb(244, 204, 120);
}

.lb-front--selected .lb-front-number {
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    background-color: rgb(92, 64, 18);
    color: rgb(255, 240, 196);
}

.lb-waves {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.lb-bases {
    flex-direction: row;
    margin-top: 4px;
}

.lb-base {
    width: 280px;
    margin: 0 6px;
    padding: 7px 14px 9px 14px;
}

.lb-base-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.lb-base-head .lb-hud-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.lb-base-title {
    margin: 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.lb-base--ally .lb-base-title { color: rgb(176, 210, 255); }
.lb-base--enemy .lb-base-title { color: rgb(255, 156, 150); }
.lb-base--ally .lb-hud-icon--castle { -unity-background-image-tint-color: rgb(196, 220, 255); }
.lb-base--enemy .lb-hud-icon--castle { -unity-background-image-tint-color: rgb(255, 186, 176); }

/* ---------- Boss ---------- */

.lb-boss {
    position: absolute;
    top: 150px;
    left: 32%;
    right: 32%;
    align-items: stretch;
}

.lb-boss-title {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
}

.lb-boss-title .lb-hud-icon {
    width: 22px;
    height: 22px;
}

.lb-boss-name {
    margin: 0 12px;
    padding: 0;
    font-size: 20px;
    letter-spacing: 4px;
    color: rgb(255, 176, 156);
}

.lb-hud .lb-boss .lb-bar {
    height: 26px;
}

/* ---------- Battlefield map (top left) ---------- */

.lb-minimap {
    position: absolute;
    left: 18px;
    top: 14px;
    width: 264px;
}

.lb-minimap-map {
    height: 270px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(219, 174, 90, 0.45);
    background-color: rgba(16, 30, 28, 0.8);
    overflow: hidden;
}

.lb-minimap-label {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    padding: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.5);
    background-color: rgb(16, 24, 44);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(238, 232, 219, 0.75);
}

.lb-minimap-label--selected {
    border-width: 2px;
    border-color: rgb(255, 209, 97);
    background-color: rgb(70, 52, 16);
    color: rgb(255, 235, 180);
}

.lb-minimap-route {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.lb-route-caption {
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.6);
}

.lb-path-hint {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(255, 214, 120);
}

/* ---------- Hero vitals (bottom left) ---------- */

.lb-vitals {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 392px;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 12px 12px;
}

.lb-portrait {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    margin-right: 14px;
}

.lb-portrait-face {
    position: absolute;
    left: 11px;
    top: 11px;
    width: 90px;
    height: 90px;
    border-radius: 45px;
    overflow: hidden;
    background-color: rgb(30, 46, 92);
}

.lb-portrait-art {
    position: absolute;
    left: -121px;
    top: -22px;
    width: 333px;
    height: 699px;
    background-image: url("Art/Hero_Commander.png");
    background-size: 100% 100%;
}

.lb-portrait-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 112px;
    height: 112px;
    background-image: url("Art/Hud_PortraitRing.png");
    background-size: 100% 100%;
}

.lb-level {
    position: absolute;
    left: -4px;
    bottom: -2px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(244, 204, 120);
    background-color: rgb(18, 28, 60);
    align-items: center;
    justify-content: center;
}

.lb-level-value {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(255, 238, 196);
}

.lb-gauges {
    flex-grow: 1;
}

.lb-hero-name {
    margin: 0 0 5px 2px;
    padding: 0;
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(244, 212, 140);
}

.lb-vital-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.lb-vital-label {
    width: 30px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.8);
}

.lb-vital-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
}

.lb-vital-row .lb-bar {
    flex-grow: 1;
}

.lb-hud .lb-bar--hp {
    height: 24px;
}

.lb-hud .lb-bar--hp .lb-bar-text {
    font-size: 13px;
}

/* ---------- Command bar (bottom centre) ---------- */

.lb-command {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    align-items: center;
}

.lb-abilities {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.lb-slot {
    width: 160px;
    align-items: center;
    margin: 0 2px;
}

.lb-socket-orb {
    width: 96px;
    height: 96px;
}

.lb-orb-glow {
    position: absolute;
    left: -18px;
    right: -18px;
    top: -18px;
    bottom: -18px;
    background-image: url("Art/Prep_Glow.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(255, 214, 140, 0.32);
}

.lb-orb, .lb-orb-dial {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 72px;
    height: 72px;
}

.lb-orb {
    border-radius: 36px;
    background-color: rgb(10, 14, 28);
    background-size: 100% 100%;
}

.lb-orb--0 { background-image: url("Art/Hud_Orb_0.png"); }
.lb-orb--1 { background-image: url("Art/Hud_Orb_1.png"); }
.lb-orb--2 { background-image: url("Art/Hud_Orb_2.png"); }
.lb-orb--3 { background-image: url("Art/Hud_Orb_3.png"); }
.lb-orb--4 { background-image: url("Art/Hud_Orb_4.png"); }
.lb-orb--5 { background-image: url("Art/Hud_Orb_5.png"); }

.lb-orb-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 96px;
    height: 96px;
    background-image: url("Art/Hud_OrbRing.png");
    background-size: 100% 100%;
}

.lb-orb-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.lb-orb-key {
    position: absolute;
    bottom: -9px;
    left: 50%;
    translate: -50% 0;
}

.lb-slot-caption {
    flex-direction: row;
    align-items: center;
    margin-top: 13px;
    padding: 2px 9px;
    border-radius: 9px;
    background-color: rgba(5, 8, 18, 0.72);
}

.lb-name {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.lb-cost {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(132, 178, 255);
}

.lb-slot--passive .lb-orb-glow { opacity: 0.3; }
.lb-slot--passive .lb-cost { color: rgba(238, 232, 219, 0.5); }
.lb-slot--cooling .lb-orb-glow { opacity: 0; }
.lb-slot--cooling .lb-name { color: rgba(238, 232, 219, 0.55); }
.lb-slot--nomana .lb-orb { -unity-background-image-tint-color: rgb(150, 156, 196); }
.lb-slot--nomana .lb-orb-glow { opacity: 0; }
.lb-slot--nomana .lb-cost { color: rgb(255, 118, 118); }

/* ---------- Troop roster (right edge) ----------
   One row per troop: framed portrait, name and Food cost. The portrait shade drains from the top as Food builds up. */

.lb-troops {
    position: absolute;
    right: 18px;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: flex-end;
}

.lb-card {
    width: 232px;
    height: 88px;
    margin: 3px 0;
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 7px;
    background-image: url("Art/Hud_Panel.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    transition-property: translate;
    transition-duration: 0.15s;
}

.lb-card-halo {
    position: absolute;
    left: -12px;
    right: -12px;
    top: -12px;
    bottom: -12px;
    background-image: url("Art/Prep_Halo.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(255, 204, 110);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.lb-card-portrait {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    margin-right: 12px;
}

.lb-card-body {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 3px;
    border-radius: 5px;
    overflow: hidden;
    background-color: rgb(22, 34, 66);
}

.lb-card-art {
    position: absolute;
    left: -32%;
    right: -32%;
    top: 2px;
    height: 200px;
    background-size: cover;
    background-position-x: center;
    background-position-y: top;
}

.lb-card--0 .lb-card-art { background-image: url("Art/Unit_Swordsman.png"); }
.lb-card--1 .lb-card-art { background-image: url("Art/Unit_Archer.png"); }
.lb-card--2 .lb-card-art { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-card--3 .lb-card-art { background-image: url("Art/Unit_Spearman.png"); }
.lb-card--4 .lb-card-art { background-image: url("Art/Unit_Priest.png"); }
.lb-card--5 .lb-card-art { background-image: url("Art/Unit_Mage.png"); }
.lb-card--6 .lb-card-art { background-image: url("Art/Unit_Knight.png"); }
.lb-card--7 .lb-card-art { background-image: url("Art/Unit_Dragon.png"); left: -60%; right: -20%; height: 110px; background-position-x: right; }

.lb-card-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background-color: rgba(4, 6, 16, 0.74);
    border-bottom-width: 1px;
    border-color: rgba(255, 214, 130, 0.7);
}

.lb-card-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("Art/Hud_CardFrame.png");
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.75px;
    -unity-background-image-tint-color: rgb(150, 146, 150);
}

.lb-card-key {
    position: absolute;
    left: -6px;
    top: -6px;
    min-width: 22px;
    height: 22px;
}

.lb-card-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.lb-card-name {
    margin: 0 0 3px 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: rgba(238, 232, 219, 0.65);
}

.lb-card-price {
    flex-direction: row;
    align-items: center;
}

.lb-card-food {
    width: 20px;
    height: 20px;
    margin-right: 5px;
}

.lb-card-cost {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.55);
}

.lb-card--ready .lb-card-halo { opacity: 0.35; }
.lb-card--ready .lb-card-frame { -unity-background-image-tint-color: rgb(255, 255, 255); }
.lb-card--ready .lb-card-name { color: rgb(255, 250, 240); }
.lb-card--ready .lb-card-cost { color: rgb(255, 214, 120); }
.lb-card--ready .lb-card-shade { border-bottom-width: 0; }

.lb-card--selected {
    translate: -14px 0;
}

.lb-card--selected .lb-card-halo {
    opacity: 0.9;
    -unity-background-image-tint-color: rgb(140, 196, 255);
}

/* ---------- Misc ---------- */

.lb-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: rgba(255, 250, 240, 0.6);
    align-items: center;
    justify-content: center;
}

.lb-crosshair-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 250, 240, 0.95);
}

.lb-toast {
    position: absolute;
    bottom: 190px;
    left: 50%;
    width: 640px;
    height: 46px;
    margin: 0 0 0 -320px;
    padding: 0;
    background-image: url("Art/Hud_Banner.png");
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 4;
    -unity-slice-bottom: 4;
    -unity-text-align: middle-center;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 245, 225);
}

.lb-hints {
    position: absolute;
    right: 18px;
    bottom: 18px;
    align-items: flex-end;
    padding: 4px 14px 10px 4px;
}

.lb-hint-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.lb-hint-row .lb-keycap {
    height: 22px;
    min-width: 22px;
}

.lb-hint-text {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 12px;
    color: rgba(238, 232, 219, 0.8);
}

.lb-hint-row .lb-keycap {
    margin-left: 12px;
}

.lb-healthbars {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lb-unit-bar {
    position: absolute;
    width: 40px;
    height: 6px;
    margin-left: -20px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
    background-color: rgba(0, 0, 0, 0.6);
}

.lb-unit-bar-fill {
    height: 100%;
    background-image: url("Art/Hud_BarFill.png");
    background-size: 100% 100%;
}

.lb-unit-bar--ally .lb-unit-bar-fill { -unity-background-image-tint-color: rgb(110, 196, 255); }
.lb-unit-bar--enemy .lb-unit-bar-fill { -unity-background-image-tint-color: rgb(236, 70, 80); }

/* ---------- Overlays: level-up and result ---------- */

.lb-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 18, 0.62);
    align-items: center;
    justify-content: center;
}

.lb-dialog {
    width: 640px;
    padding: 18px 24px;
    align-items: center;
}

.lb-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 205, 128);
    margin-bottom: 4px;
}

.lb-title--defeat {
    color: rgb(230, 110, 110);
}

.lb-subtitle {
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-stats {
    align-self: stretch;
    margin: 6px 0 10px 0;
}

.lb-stat {
    font-size: 14px;
    white-space: normal;
}

.lb-ratings {
    flex-direction: row;
    margin: 4px 0 8px 0;
}

.lb-rating {
    width: 44px;
    height: 32px;
    margin: 0 3px;
    background-color: rgba(30, 44, 84, 0.95);
    border-color: rgba(219, 174, 90, 0.5);
    color: rgb(238, 232, 219);
}

.lb-rating--on {
    background-color: rgb(212, 168, 74);
    color: rgb(20, 20, 30);
}

.lb-note {
    align-self: stretch;
    min-height: 60px;
    margin-bottom: 10px;
}

.lb-primary {
    height: 40px;
    width: 300px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(52, 84, 173);
    border-color: rgb(240, 205, 128);
    color: rgb(255, 250, 240);
}

.lb-primary:hover {
    background-color: rgb(72, 108, 210);
}

/* ---------- Campaign preparation ----------
   Full screen: the preparation camera renders nothing behind it. Textures in Art/ come from
   Lightbringer/UI/Build Preparation Art; Cinzel (OFL) is the display face. */

.lb-display {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
}

.lb-prep {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(5, 8, 16);
    color: rgb(238, 232, 219);
}

.lb-prep-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Art/Prep_Background.png");
    background-size: cover;
}

.lb-prep-rune {
    position: absolute;
    left: -130px;
    top: 180px;
    width: 960px;
    height: 960px;
    background-image: url("Art/Prep_Rune.png");
    background-size: contain;
    -unity-background-image-tint-color: rgba(240, 200, 120, 0.24);
}

.lb-prep-rune--inner {
    left: 60px;
    top: 370px;
    width: 580px;
    height: 580px;
    -unity-background-image-tint-color: rgba(150, 190, 255, 0.26);
}

.lb-prep-hero-glow {
    position: absolute;
    left: -60px;
    top: 160px;
    width: 820px;
    height: 820px;
    background-image: url("Art/Prep_Glow.png");
    background-size: contain;
    -unity-background-image-tint-color: rgba(255, 214, 140, 0.22);
}

.lb-prep-hero {
    position: absolute;
    left: 90px;
    top: 150px;
    width: 520px;
    height: 1090px;
    background-image: url("Art/Hero_Commander.png");
    background-size: contain;
    background-position-y: top;
}

.lb-prep-motes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lb-prep-mote {
    position: absolute;
    left: 0;
    top: 0;
    background-image: url("Art/Prep_Glow.png");
    background-size: contain;
    -unity-background-image-tint-color: rgb(255, 236, 190);
}

/* Header */

.lb-prep-header {
    position: absolute;
    left: 48px;
    top: 28px;
    flex-direction: row;
    align-items: center;
}

.lb-prep-emblem {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    background-image: url("Art/Prep_Star.png");
    background-size: contain;
    -unity-background-image-tint-color: rgb(240, 205, 128);
}

.lb-prep-title {
    margin: 0;
    padding: 0;
    font-size: 46px;
    letter-spacing: 6px;
    color: rgb(244, 212, 140);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
}

.lb-prep-subtitle {
    margin: 0;
    padding: 0 0 0 3px;
    font-size: 14px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.7);
}

/* Framed panels */

.lb-prep-frame {
    background-image: url("Art/Prep_Frame.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 26;
    -unity-slice-bottom: 26;
}

.lb-prep-plate {
    position: absolute;
    left: 40px;
    bottom: 34px;
    width: 560px;
    flex-direction: row;
    align-items: center;
    padding: 16px 22px 18px 18px;
}

.lb-prep-medal {
    width: 76px;
    height: 76px;
    margin-right: 16px;
    border-radius: 38px;
    border-width: 2px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(24, 36, 72);
    align-items: center;
    justify-content: center;
}

.lb-prep-medal-label {
    margin: 0 0 -4px 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(240, 205, 128);
}

.lb-prep-medal-value {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: rgb(255, 240, 200);
    -unity-text-align: middle-center;
}

.lb-prep-identity {
    flex-grow: 1;
}

.lb-prep-hero-name {
    margin: 0;
    padding: 0;
    font-size: 24px;
    letter-spacing: 3px;
    color: rgb(244, 212, 140);
}

.lb-prep-hero-role {
    margin: 0 0 6px 0;
    padding: 0;
    font-size: 13px;
    color: rgba(238, 232, 219, 0.65);
}

.lb-bar--exp .lb-bar-fill { background-color: rgb(150, 120, 210); }

.lb-prep-content {
    position: absolute;
    left: 640px;
    right: 40px;
    top: 120px;
    bottom: 30px;
    flex-direction: row;
}

.lb-prep-column {
    flex-basis: 0;
    flex-direction: column;
}

.lb-prep-column--campaign {
    flex-grow: 0.92;
    margin-right: 18px;
}

.lb-prep-column--army {
    flex-grow: 1.08;
}

.lb-prep-panel {
    margin-bottom: 14px;
    padding: 16px 20px 18px 20px;
}

.lb-prep-panel-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.lb-prep-bullet {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    background-image: url("Art/Prep_Star.png");
    background-size: contain;
    -unity-background-image-tint-color: rgb(240, 205, 128);
}

.lb-prep-panel-title {
    margin: 0;
    padding: 0;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(244, 212, 140);
}

.lb-prep-hint {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 12px;
    color: rgba(238, 232, 219, 0.5);
}

.lb-chips .lb-prep-hint, .lb-rewards .lb-prep-hint {
    margin-left: 0;
}

.lb-reward .lb-prep-hint {
    margin-left: 8px;
}

.lb-prep-caption {
    margin: 12px 0 6px 0;
    padding: 0;
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(240, 205, 128, 0.8);
}

/* Campaign route */

.lb-route {
    flex-direction: row;
    justify-content: space-between;
    height: 96px;
    padding: 0 4px;
}

.lb-route-track {
    position: absolute;
    left: 35px;
    right: 35px;
    top: 27px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(238, 232, 219, 0.12);
}

.lb-route-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 2px;
    background-color: rgb(232, 192, 110);
}

.lb-prep .lb-stage {
    width: 62px;
    height: 96px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
    opacity: 1;
}

.lb-prep .lb-stage:hover, .lb-prep .lb-stage:active, .lb-prep .lb-stage:focus, .lb-prep .lb-stage:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

.lb-stage-glow {
    position: absolute;
    left: -24px;
    top: -26px;
    width: 110px;
    height: 110px;
    background-image: url("Art/Prep_Glow.png");
    background-size: contain;
    -unity-background-image-tint-color: rgba(255, 210, 120, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.lb-stage-circle {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    border-width: 2px;
    border-color: rgba(219, 174, 90, 0.55);
    background-color: rgb(16, 24, 46);
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.15s;
}

.lb-stage-number {
    margin: 0;
    padding: 0;
    font-size: 22px;
    color: rgb(238, 232, 219);
    -unity-text-align: middle-center;
}

.lb-stage-state {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.55);
}

.lb-stage--new .lb-stage-circle { background-color: rgb(26, 40, 80); }
.lb-stage--new .lb-stage-state { color: rgb(158, 204, 255); }
.lb-stage--cleared .lb-stage-circle { background-color: rgb(28, 46, 58); border-color: rgba(150, 210, 150, 0.7); }
.lb-stage--cleared .lb-stage-state { color: rgb(150, 210, 150); }
.lb-stage--boss .lb-stage-circle { background-color: rgb(56, 18, 30); border-color: rgb(220, 90, 100); }
.lb-stage--boss .lb-stage-state { color: rgb(255, 140, 140); }

.lb-prep .lb-stage:hover .lb-stage-circle {
    border-color: rgb(255, 225, 150);
    scale: 1.08 1.08;
}

.lb-prep .lb-stage--selected .lb-stage-circle {
    border-width: 3px;
    border-color: rgb(255, 226, 160);
    background-color: rgb(52, 76, 140);
    scale: 1.12 1.12;
}

.lb-stage--selected .lb-stage-glow { opacity: 1; }
.lb-stage--selected .lb-stage-number { color: rgb(255, 255, 255); }

.lb-prep .lb-stage:disabled .lb-stage-circle {
    background-color: rgb(10, 14, 26);
    border-color: rgba(238, 232, 219, 0.12);
}

.lb-prep .lb-stage:disabled .lb-stage-number { color: rgba(238, 232, 219, 0.25); }
.lb-prep .lb-stage:disabled .lb-stage-state { color: rgba(238, 232, 219, 0.3); }

/* Briefing */

.lb-prep-panel--briefing {
    flex-grow: 1;
    overflow: hidden;
}

.lb-briefing-rune {
    position: absolute;
    right: -90px;
    top: -40px;
    width: 340px;
    height: 340px;
    background-image: url("Art/Prep_Rune.png");
    background-size: contain;
    -unity-background-image-tint-color: rgba(158, 190, 255, 0.12);
}

.lb-briefing-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.lb-briefing-title {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 4px;
    color: rgb(255, 240, 205);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.lb-briefing-tag {
    margin: 0 0 0 14px;
    padding: 3px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(158, 204, 255, 0.6);
    background-color: rgba(30, 50, 100, 0.6);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(158, 204, 255);
}

.lb-briefing-tag--boss {
    border-color: rgb(220, 90, 100);
    background-color: rgba(90, 20, 34, 0.75);
    color: rgb(255, 150, 150);
}

.lb-briefing-tag--cleared {
    border-color: rgba(150, 210, 150, 0.7);
    background-color: rgba(30, 60, 40, 0.6);
    color: rgb(150, 210, 150);
}

.lb-briefing-note {
    margin: 16px 0 0 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgba(238, 232, 219, 0.7);
}

.lb-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.lb-chip {
    flex-direction: row;
    align-items: center;
    margin: 0 6px 6px 0;
    padding: 4px 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.18);
    background-color: rgba(24, 36, 70, 0.85);
}

.lb-chip-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 4px;
    background-color: rgb(230, 130, 90);
}

.lb-chip--heavy .lb-chip-dot { background-color: rgb(220, 60, 80); }

.lb-chip-name {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(238, 232, 219);
}

/* Battlefield schematic: our gate below, the enemy stronghold above, one lane per Path. */

.lb-map {
    flex-grow: 1;
    min-height: 150px;
    max-height: 260px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(219, 174, 90, 0.3);
    background-color: rgba(6, 10, 20, 0.6);
    overflow: hidden;
}

.lb-map-base {
    position: absolute;
    left: 12%;
    right: 12%;
    height: 26px;
    margin: 0;
    padding: 0;
    border-radius: 4px;
    border-width: 1px;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.lb-map-base--enemy {
    top: 10px;
    border-color: rgb(200, 80, 90);
    background-color: rgba(110, 26, 38, 0.75);
    color: rgb(255, 170, 170);
}

.lb-map-base--boss {
    border-color: rgb(255, 110, 130);
    background-color: rgba(150, 20, 50, 0.9);
}

.lb-map-base--ally {
    bottom: 10px;
    border-color: rgb(120, 170, 255);
    background-color: rgba(30, 52, 110, 0.8);
    color: rgb(190, 215, 255);
}

.lb-map-path {
    position: absolute;
    top: 36px;
    bottom: 36px;
    width: 0;
}

.lb-map-path-line {
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: rgba(232, 192, 110, 0.75);
}

.lb-map-path-label {
    position: absolute;
    left: -34px;
    top: 42%;
    width: 68px;
    margin: 0;
    padding: 2px 0;
    border-radius: 3px;
    background-color: rgb(12, 18, 36);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 205, 128);
}

.lb-chip-badge {
    margin: 0 0 0 7px;
    padding: 0 5px;
    border-radius: 3px;
    background-color: rgb(212, 168, 74);
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(20, 20, 30);
}

.lb-chip-detail {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 12px;
    color: rgb(240, 205, 128);
}

.lb-rewards {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.lb-reward {
    flex-direction: row;
    align-items: center;
    margin: 0 12px 6px 0;
    padding: 5px 12px 5px 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(219, 174, 90, 0.35);
    background-color: rgba(8, 12, 24, 0.55);
}

.lb-reward .lb-reward-icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
}

.lb-reward-value {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 245, 225);
}

/* Start */

.lb-launch {
    height: 84px;
    justify-content: center;
}

.lb-launch-glow {
    position: absolute;
    left: 12px;
    right: 12px;
    top: -6px;
    bottom: -6px;
    background-image: url("Art/Prep_Halo.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.333px;
    -unity-background-image-tint-color: rgb(255, 210, 120);
}

.lb-prep .lb-launch-button {
    height: 72px;
    margin: 0 24px;
    padding: 0;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(40, 66, 146);
    font-size: 26px;
    letter-spacing: 4px;
    color: rgb(255, 246, 225);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.lb-prep .lb-launch-button:hover {
    background-color: rgb(56, 88, 186);
    border-color: rgb(255, 232, 170);
    scale: 1.02 1.02;
}

.lb-prep .lb-launch-button:active {
    background-color: rgb(32, 54, 120);
    scale: 0.99 0.99;
}

.lb-prep .lb-launch-button:disabled {
    background-color: rgb(30, 36, 56);
    border-color: rgba(238, 232, 219, 0.2);
    color: rgba(238, 232, 219, 0.4);
    opacity: 1;
}

.lb-prep-footnote {
    align-self: center;
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: rgba(238, 232, 219, 0.45);
}

/* Loadout */

.lb-sockets {
    flex-direction: row;
    margin-bottom: 12px;
}

.lb-halo {
    position: absolute;
    left: -12px;
    right: -12px;
    top: -12px;
    bottom: -12px;
    background-image: url("Art/Prep_Halo.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.333px;
    -unity-background-image-tint-color: rgb(255, 210, 120);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.lb-prep .lb-socket {
    flex-grow: 1;
    flex-basis: 0;
    height: 92px;
    margin: 0 4px;
    padding: 8px 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(219, 174, 90, 0.45);
    background-color: rgba(20, 30, 58, 0.92);
    overflow: visible;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.lb-prep .lb-socket:hover {
    border-color: rgb(255, 225, 150);
    background-color: rgb(32, 48, 92);
}

.lb-prep .lb-socket--active, .lb-prep .lb-socket--active:hover {
    border-width: 2px;
    border-color: rgb(255, 226, 160);
    background-color: rgb(44, 64, 120);
}

.lb-socket--active .lb-halo { opacity: 0.9; }

.lb-socket-ring {
    width: 58px;
    height: 58px;
    margin-right: 8px;
    flex-shrink: 0;
    border-radius: 29px;
    border-width: 2px;
    border-color: rgba(219, 174, 90, 0.7);
    background-color: rgb(10, 16, 32);
    align-items: center;
    justify-content: center;
}

.lb-socket-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.lb-socket-key {
    align-self: flex-start;
    margin: 0 0 3px 0;
    padding: 0 6px;
    border-radius: 3px;
    background-color: rgba(240, 205, 128, 0.9);
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(20, 20, 30);
}

.lb-socket-name {
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(238, 232, 219);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.lb-socket-note {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: rgba(238, 232, 219, 0.65);
    -unity-text-align: middle-left;
}

.lb-icon {
    width: 48px;
    height: 48px;
    background-size: contain;
}

.lb-icon--0 { background-image: url("Art/Item_LightStaff.png"); }
.lb-icon--1 { background-image: url("Art/Item_HealingStaff.png"); }
.lb-icon--2 { background-image: url("Art/Item_RuneStaff.png"); }
.lb-icon--3 { background-image: url("Art/Item_FoodRing.png"); }
.lb-icon--4 { background-image: url("Art/Item_ManaRing.png"); }
.lb-icon--5 { background-image: url("Art/Item_VitalityRing.png"); }

.lb-armory {
    flex-direction: row;
}

.lb-prep .lb-item {
    flex-grow: 1;
    flex-basis: 0;
    height: 104px;
    margin: 0 4px;
    padding: 6px 4px;
    align-items: center;
    justify-content: flex-start;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(219, 174, 90, 0.35);
    background-color: rgba(18, 27, 52, 0.92);
    overflow: visible;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.lb-prep .lb-item:hover {
    border-color: rgb(255, 225, 150);
    background-color: rgb(30, 46, 88);
    scale: 1.04 1.04;
}

.lb-prep .lb-item--equipped, .lb-prep .lb-item--equipped:hover {
    border-width: 2px;
    border-color: rgb(255, 226, 160);
    background-color: rgb(44, 64, 120);
}

.lb-item--equipped .lb-halo { opacity: 0.75; }

.lb-prep .lb-item:disabled {
    opacity: 0.5;
    background-color: rgba(14, 20, 36, 0.92);
    border-color: rgba(238, 232, 219, 0.12);
}

.lb-item .lb-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 4px;
}

.lb-item--locked .lb-icon { -unity-background-image-tint-color: rgb(50, 60, 84); }

.lb-item-name {
    max-width: 100%;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(238, 232, 219);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.lb-item-note {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 10px;
    white-space: nowrap;
    color: rgba(238, 232, 219, 0.6);
}

.lb-item--used .lb-item-note { color: rgb(158, 204, 255); }

/* Troops */

.lb-troops-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.lb-troop {
    width: 24%;
    height: 172px;
    margin-bottom: 8px;
    justify-content: flex-end;
    padding-bottom: 6px;
    overflow: hidden;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(219, 174, 90, 0.45);
    background-color: rgb(14, 22, 44);
}

.lb-troop-glow {
    position: absolute;
    left: -20%;
    right: -20%;
    top: -10%;
    height: 100%;
    background-image: url("Art/Prep_Glow.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(120, 160, 255, 0.35);
}

.lb-troop-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    bottom: 0;
    background-size: cover;
    background-position-x: center;
    background-position-y: top;
}

.lb-troop-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
    background-image: url("Art/Prep_Fade.png");
    background-size: 100% 100%;
}

.lb-troop-name {
    margin: 0;
    padding: 0 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 250, 240);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.lb-troop-cost {
    margin: 0;
    padding: 0 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(240, 205, 128);
}

.lb-troop--0 .lb-troop-art { background-image: url("Art/Unit_Swordsman.png"); }
.lb-troop--1 .lb-troop-art { background-image: url("Art/Unit_Archer.png"); }
.lb-troop--2 .lb-troop-art { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-troop--3 .lb-troop-art { background-image: url("Art/Unit_Spearman.png"); }
.lb-troop--4 .lb-troop-art { background-image: url("Art/Unit_Priest.png"); }
.lb-troop--5 .lb-troop-art { background-image: url("Art/Unit_Mage.png"); }
.lb-troop--6 .lb-troop-art { background-image: url("Art/Unit_Knight.png"); }
.lb-troop--7 .lb-troop-art { background-image: url("Art/Unit_Dragon.png"); background-position-x: right; }

.lb-troop--locked { border-color: rgba(238, 232, 219, 0.12); }
.lb-troop--locked .lb-troop-art { -unity-background-image-tint-color: rgb(16, 22, 40); }
.lb-troop--locked .lb-troop-glow { opacity: 0; }
.lb-troop--locked .lb-troop-name { color: rgba(238, 232, 219, 0.45); }
.lb-troop--locked .lb-troop-cost { color: rgba(238, 232, 219, 0.35); }

.lb-prep-status {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 8px;
    font-size: 11px;
    color: rgba(238, 232, 219, 0.55);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Level-up blessings ----------
   Full-screen overlay above the paused battle: three large cards dealt in by LevelUpView.
   Card frame and growth icons come from Lightbringer/UI/Build Preparation Art. */

.lb-levelup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    color: rgb(238, 232, 219);
}

.lb-levelup-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 14, 0.93);
}

.lb-levelup-rune {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1100px;
    height: 1100px;
    margin-left: -550px;
    margin-top: -530px;
    background-image: url("Art/Prep_Rune.png");
    background-size: contain;
    -unity-background-image-tint-color: rgba(240, 200, 120, 0.09);
}

.lb-levelup-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1500px;
    height: 900px;
    margin-left: -750px;
    margin-top: -440px;
    background-image: url("Art/Prep_Glow.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(120, 150, 255, 0.16);
}

.lb-levelup-header {
    align-items: center;
    margin-bottom: 34px;
}

.lb-levelup-title-row {
    flex-direction: row;
    align-items: center;
}

.lb-levelup-title {
    margin: 0 26px;
    padding: 0;
    font-size: 72px;
    letter-spacing: 10px;
    color: rgb(250, 222, 150);
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.8);
}

.lb-levelup-ornament {
    flex-direction: row;
    align-items: center;
}

.lb-levelup-ornament--right {
    flex-direction: row-reverse;
}

.lb-levelup-ornament .lb-prep-bullet {
    width: 22px;
    height: 22px;
    margin: 0;
}

.lb-levelup-ornament-line {
    width: 190px;
    height: 2px;
    margin: 0 10px;
    background-color: rgba(240, 205, 128, 0.55);
}

.lb-levelup-subtitle {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 17px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.78);
}

.lb-levelup-remaining {
    margin: 10px 0 0 0;
    padding: 4px 14px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(240, 205, 128, 0.6);
    background-color: rgba(40, 66, 146, 0.55);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(250, 222, 150);
}

.lb-lvcards {
    flex-direction: row;
    justify-content: center;
}

.lb-lvslot {
    margin: 0 20px;
}

.lb-lvcard {
    width: 420px;
    height: 600px;
    margin: 0;
    padding: 58px 34px 26px 34px;
    align-items: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Art/LevelUp_Card.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    color: rgb(238, 232, 219);
    transition-property: scale, translate, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.lb-lvcard:hover {
    scale: 1.035 1.035;
    translate: 0 -10px;
    background-color: rgba(0, 0, 0, 0);
}

.lb-lvcard:active {
    scale: 1.0 1.0;
    translate: 0 -4px;
}

.lb-lvcard .lb-halo {
    left: -18px;
    right: -18px;
    top: -18px;
    bottom: -18px;
}

.lb-lvcard:hover .lb-halo {
    opacity: 0.55;
}

/* Selected card stays raised with a full halo until CONFIRM; the other two step back. */
.lb-lvcard--selected, .lb-lvcard--selected:hover {
    scale: 1.05 1.05;
    translate: 0 -16px;
}

.lb-lvcard--selected .lb-halo, .lb-lvcard--selected:hover .lb-halo {
    opacity: 1;
    -unity-background-image-tint-color: rgb(255, 230, 160);
}

.lb-lvcard--selected .lb-lvcard-shine {
    opacity: 0.5;
}

.lb-lvcard--selected .lb-lvcard-medal {
    background-color: rgb(196, 150, 64);
    border-color: rgb(255, 244, 205);
}

.lb-lvcard--dimmed {
    opacity: 0.5;
}

.lb-lvcard--dimmed:hover {
    opacity: 0.85;
}

.lb-lvcard-shine {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 30px;
    height: 300px;
    background-image: url("Art/Prep_Glow.png");
    background-size: 100% 100%;
    opacity: 0.22;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.lb-lvcard:hover .lb-lvcard-shine {
    opacity: 0.4;
}

.lb-lvcard-medal {
    position: absolute;
    left: 50%;
    top: -30px;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(24, 36, 72);
    align-items: center;
    justify-content: center;
}

.lb-lvcard:hover .lb-lvcard-medal {
    background-color: rgb(40, 66, 146);
    border-color: rgb(255, 236, 180);
}

.lb-lvcard-number {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: rgb(255, 240, 200);
    -unity-text-align: middle-center;
}

.lb-lvcard-category {
    margin: 0;
    padding: 0;
    font-size: 13px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.lb-lvcard-well {
    width: 196px;
    height: 196px;
    margin: 10px 0 8px 0;
    align-items: center;
    justify-content: center;
}

.lb-lvcard-well-glow {
    position: absolute;
    left: -20px;
    right: -20px;
    top: -20px;
    bottom: -20px;
    background-image: url("Art/Prep_Glow.png");
    background-size: contain;
    opacity: 0.5;
}

.lb-lvcard-well-rune {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("Art/Prep_Rune.png");
    background-size: contain;
    opacity: 0.45;
}

.lb-growth-icon {
    width: 150px;
    height: 150px;
    background-size: contain;
}

.lb-growth-icon--AuraSize { background-image: url("Art/Growth_AuraSize.png"); }
.lb-growth-icon--FoodProduction { background-image: url("Art/Growth_FoodProduction.png"); }
.lb-growth-icon--ManaRecovery { background-image: url("Art/Growth_ManaRecovery.png"); }
.lb-growth-icon--Capacity { background-image: url("Art/Growth_Capacity.png"); }
.lb-growth-icon--Leadership { background-image: url("Art/Growth_Leadership.png"); }
.lb-growth-icon--AuraBuff { background-image: url("Art/Growth_AuraBuff.png"); }
.lb-growth-icon--HeroPower { background-image: url("Art/Growth_HeroPower.png"); }
.lb-growth-icon--HeroVitality { background-image: url("Art/Growth_HeroVitality.png"); }

.lb-lvcard-title {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 30px;
    letter-spacing: 1px;
    color: rgb(250, 222, 150);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-lvcard-divider {
    flex-direction: row;
    align-items: center;
    margin: 10px 0 12px 0;
}

.lb-lvcard-divider .lb-prep-bullet {
    width: 14px;
    height: 14px;
    margin: 0 8px;
}

.lb-lvcard-divider-line {
    width: 90px;
    height: 1px;
    background-color: rgba(240, 205, 128, 0.45);
}

.lb-lvcard-description {
    min-height: 52px;
    margin: 0;
    padding: 0;
    font-size: 17px;
    color: rgba(238, 232, 219, 0.82);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-lvcard-effect {
    margin: 12px 0 0 0;
    padding: 0;
    font-size: 23px;
    -unity-text-align: middle-center;
}

.lb-lvcard-footer {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 26px;
    height: 40px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-color: rgba(240, 205, 128, 0.3);
}

.lb-lvcard-rank {
    margin: 0;
    padding: 0;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.6);
}

.lb-lvcard-total {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(250, 222, 150);
}

/* Category tints: shine, icon well, label and effect line. */
.lb-lvcard--aura .lb-lvcard-shine, .lb-lvcard--aura .lb-lvcard-well-glow { -unity-background-image-tint-color: rgb(255, 205, 120); }
.lb-lvcard--aura .lb-lvcard-well-rune { -unity-background-image-tint-color: rgb(255, 215, 140); }
.lb-lvcard--aura .lb-lvcard-category, .lb-lvcard--aura .lb-lvcard-effect { color: rgb(255, 210, 120); }
.lb-lvcard--supply .lb-lvcard-shine, .lb-lvcard--supply .lb-lvcard-well-glow { -unity-background-image-tint-color: rgb(150, 225, 120); }
.lb-lvcard--supply .lb-lvcard-well-rune { -unity-background-image-tint-color: rgb(175, 235, 150); }
.lb-lvcard--supply .lb-lvcard-category, .lb-lvcard--supply .lb-lvcard-effect { color: rgb(160, 230, 130); }
.lb-lvcard--magic .lb-lvcard-shine, .lb-lvcard--magic .lb-lvcard-well-glow { -unity-background-image-tint-color: rgb(110, 160, 255); }
.lb-lvcard--magic .lb-lvcard-well-rune { -unity-background-image-tint-color: rgb(150, 190, 255); }
.lb-lvcard--magic .lb-lvcard-category, .lb-lvcard--magic .lb-lvcard-effect { color: rgb(140, 185, 255); }
.lb-lvcard--command .lb-lvcard-shine, .lb-lvcard--command .lb-lvcard-well-glow { -unity-background-image-tint-color: rgb(170, 130, 255); }
.lb-lvcard--command .lb-lvcard-well-rune { -unity-background-image-tint-color: rgb(195, 165, 255); }
.lb-lvcard--command .lb-lvcard-category, .lb-lvcard--command .lb-lvcard-effect { color: rgb(195, 165, 255); }
.lb-lvcard--hero .lb-lvcard-shine, .lb-lvcard--hero .lb-lvcard-well-glow { -unity-background-image-tint-color: rgb(255, 120, 110); }
.lb-lvcard--hero .lb-lvcard-well-rune { -unity-background-image-tint-color: rgb(255, 160, 140); }
.lb-lvcard--hero .lb-lvcard-category, .lb-lvcard--hero .lb-lvcard-effect { color: rgb(255, 150, 135); }

.lb-levelup-prompt {
    align-items: center;
    margin-top: 32px;
}

.lb-levelup-prompt-title {
    margin: 0;
    padding: 0;
    font-size: 26px;
    letter-spacing: 8px;
    color: rgb(244, 212, 140);
}

.lb-levelup-prompt-hint {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(238, 232, 219, 0.55);
}

.lb-levelup-confirm {
    width: 340px;
    height: 62px;
    margin: 16px 0 0 0;
    padding: 0;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(40, 66, 146);
    font-size: 24px;
    letter-spacing: 6px;
    color: rgb(255, 246, 225);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.lb-levelup-confirm:hover {
    background-color: rgb(56, 88, 186);
    border-color: rgb(255, 232, 170);
    scale: 1.03 1.03;
}

.lb-levelup-confirm:active {
    background-color: rgb(32, 54, 120);
    scale: 0.99 0.99;
}

.lb-levelup-confirm:disabled {
    background-color: rgb(30, 36, 56);
    border-color: rgba(238, 232, 219, 0.2);
    color: rgba(238, 232, 219, 0.4);
    opacity: 1;
    scale: 1 1;
}

.lb-hidden {
    display: none;
}
