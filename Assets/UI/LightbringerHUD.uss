/* Lightbringer desktop HUD. Palette follows the character sheet: navy panels, gold trim, ivory text.
   The view code only depends on the class names. Battle HUD art: Assets/UI/Art/Hud_*.png
   (Lightbringer/UI/Build Battle HUD Art). */

/* ---------- Shared ---------- */

.lb-boss-cinematic { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12, 2, 24, 0.12); }
.lb-boss-letterbox { position: absolute; left: 0; right: 0; top: 0; height: 8%; background-color: rgba(3, 2, 8, 0.95); }
.lb-boss-chapter { position: absolute; left: 8%; right: 8%; bottom: 12%; font-size: 40px; letter-spacing: 5px; color: rgb(230, 212, 250); -unity-text-align: middle-center; text-shadow: 0 3px 12px rgb(0, 0, 0); }
.lb-boss-dialogue { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 10% 24px 10%; background-color: rgba(8, 4, 17, 0.96); border-top-width: 2px; border-top-color: rgb(119, 74, 151); }
.lb-boss-speaker { font-size: 22px; color: rgb(203, 159, 235); margin-bottom: 12px; }
.lb-boss-line { font-size: 24px; white-space: normal; min-height: 65px; color: rgb(245, 239, 251); }
.lb-boss-dialogue-controls { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 14px; }
.lb-boss-dialogue-count { font-size: 14px; color: rgb(166, 151, 181); }
.lb-boss-next { padding: 10px 22px; background-color: rgb(43, 24, 61); border-width: 1px; border-color: rgb(129, 88, 160); color: rgb(240, 230, 251); font-size: 17px; }
.lb-boss-next:hover { background-color: rgb(71, 38, 96); }
.lb-boss-story { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(4, 3, 8); }
.lb-boss-story-caption { padding: 18px 8% 20px 8%; background-color: rgba(5, 4, 11, 0.84); border-top-width: 0; }
.lb-boss-story-caption .lb-boss-speaker { font-size: 20px; margin-bottom: 8px; }
.lb-boss-story-caption .lb-boss-line { font-size: 24px; min-height: 50px; }
.lb-boss-story-caption .lb-boss-dialogue-controls { margin-top: 8px; }

.lb-campaign-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-prologue { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(4, 6, 9); overflow: hidden; }
.lb-prologue-frame { position: absolute; }
.lb-prologue-picture { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-prologue-top { position: absolute; left: 4%; right: 4%; top: 3%; flex-direction: row; justify-content: space-between; align-items: center; }
.lb-prologue-top .lb-atlas-brand { margin-bottom: 0; }
.lb-prologue-caption-panel { position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 14% 26px 14%; background-color: rgba(4, 6, 9, 0.0); border-width: 0; }
.lb-prologue-caption { font-size: 26px; color: rgb(244, 238, 220); white-space: normal; -unity-text-align: middle-center; min-height: 76px; margin-bottom: 14px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95); }
.lb-prologue-controls { flex-direction: row; justify-content: center; }
.lb-prologue-button { height: 30px; min-width: 84px; padding: 0 14px; margin: 0 6px; background-color: rgba(0, 0, 0, 0); border-width: 0 0 1px 0; border-color: rgba(197, 180, 140, 0.25); border-radius: 0; color: rgb(190, 182, 160); font-size: 13px; letter-spacing: 1px; }
.lb-prologue-button:hover { background-color: rgba(0, 0, 0, 0); border-color: rgb(226, 208, 160); color: rgb(246, 238, 214); }
.lb-prologue-button:disabled { opacity: 0.3; }
.lb-prologue-music { position: absolute; left: 4%; top: 9%; }
.lb-prologue-credits { background-color: rgba(7, 11, 17, 0.96); padding: 18px; color: rgb(216, 211, 192); font-size: 14px; }

/* Campaign atlas: matte cartography, small ivory typography and restrained brass accents. */
.lb-atlas { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(8, 14, 18); overflow: hidden; }
.lb-atlas-canvas { position: absolute; }
.lb-atlas-paper, .lb-atlas-roads { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-atlas-paper { background-image: url("Art/CampaignAtlas_v1.png"); -unity-background-scale-mode: stretch-to-fill; }
.lb-atlas-header { position: absolute; top: 42px; left: 64px; right: 64px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.lb-atlas-brand { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 14px; letter-spacing: 5px; color: rgb(188, 174, 140); margin-bottom: 15px; }
.lb-atlas-title { font-size: 32px; color: rgb(235, 234, 222); letter-spacing: 2px; }
.lb-atlas-subtitle { font-size: 14px; color: rgb(153, 168, 167); margin-top: 9px; }
.lb-atlas-progress { font-size: 14px; color: rgb(212, 203, 178); padding-top: 8px; letter-spacing: 1px; }
.lb-atlas-footer { position: absolute; left: 64px; right: 64px; bottom: 40px; flex-direction: row; justify-content: space-between; align-items: center; border-top-width: 1px; border-top-color: rgba(210, 204, 176, 0.28); padding-top: 20px; padding-bottom: 12px; background-color: rgba(8, 14, 18, 0.86); }
.lb-atlas-detail { flex-shrink: 1; padding-left: 18px; }
.lb-atlas-eyebrow { font-size: 11px; letter-spacing: 2px; color: rgb(169, 158, 127); }
.lb-atlas-selected { font-size: 27px; color: rgb(234, 232, 217); margin-top: 6px; margin-bottom: 7px; }
.lb-atlas-description { font-size: 14px; color: rgb(166, 179, 177); white-space: normal; }
.lb-atlas-action { width: 310px; margin-left: 24px; margin-right: 18px; }
.lb-atlas-hint { font-size: 11px; color: rgb(155, 165, 161); margin-bottom: 12px; -unity-text-align: middle-right; }
.lb-atlas-primary { height: 52px; background-color: rgb(195, 177, 130); color: rgb(21, 29, 30); border-width: 1px; border-color: rgb(211, 195, 154); border-radius: 2px; font-size: 17px; margin: 0; }
.lb-atlas-primary:hover, .lb-atlas-primary:focus { background-color: rgb(224, 209, 169); border-color: rgb(249, 238, 208); }
.lb-atlas-primary:active { background-color: rgb(169, 149, 103); }
.lb-atlas-primary:disabled { opacity: 0.4; }
.lb-atlas-status { position: absolute; bottom: 8px; left: 64px; color: rgb(212, 184, 145); font-size: 12px; }
.lb-beacon { position: absolute; width: 132px; height: 136px; margin: -38px 0 0 -66px; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; align-items: center; transition-duration: 0.15s; transition-property: scale; }
.lb-beacon:hover, .lb-beacon:focus { scale: 1.06 1.06; background-color: rgba(0, 0, 0, 0); }
.lb-beacon--selected { scale: 1.16 1.16; background-color: rgba(0, 0, 0, 0); }
.lb-beacon--selected:hover, .lb-beacon--selected:focus { scale: 1.18 1.18; }
.lb-beacon:disabled { opacity: 0.6; }
.lb-beacon-symbol { width: 74px; height: 88px; background-image: url("Art/Beacon_Dark.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-beacon--ready .lb-beacon-symbol { background-image: url("Art/Beacon_Ready.png"); }
.lb-beacon--lit .lb-beacon-symbol { background-image: url("Art/Beacon_Lit.png"); }
.lb-beacon-name { color: rgb(127, 144, 156); font-size: 13px; margin-top: 2px; padding: 3px 14px; background-color: rgba(8, 13, 20, 0.88); border-width: 1px; border-color: rgba(120, 140, 155, 0.35); -unity-text-align: middle-center; letter-spacing: 1px; }
.lb-beacon-state { color: rgb(120, 138, 150); font-size: 10px; margin-top: 3px; -unity-text-align: middle-center; }
.lb-beacon--ready .lb-beacon-name { color: rgb(236, 246, 255); border-color: rgba(191, 228, 255, 0.65); }
.lb-beacon--ready .lb-beacon-state { color: rgb(191, 228, 255); }
.lb-beacon--lit .lb-beacon-name { color: rgb(243, 227, 180); border-color: rgba(214, 178, 100, 0.65); }
.lb-beacon--lit .lb-beacon-state { color: rgb(239, 217, 161); }
.lb-beacon--selected .lb-beacon-name { color: rgb(255, 255, 255); border-color: rgb(240, 216, 144); background-color: rgba(18, 32, 48, 0.95); }

/* Bundle the Korean font so player builds do not depend on OS fallback fonts. */
:root {
    -unity-font-definition: url("Fonts/NanumGothic-Regular.ttf");
}

.lb-caption {
    font-size: 13px;
    color: rgba(238, 232, 219, 0.7);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lb-bar {
    height: 18px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.25);
    overflow: hidden;
    margin: 2px 0;
}

.lb-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
}

.lb-bar-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 250, 240);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

/* ---------- Battle HUD frame ---------- */

.lb-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(244, 238, 226);
    font-size: 16px;
}

.lb-hud Label {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* Darkens the ground behind the command bar so cards and orbs stay readable on bright grass. */
.lb-hud-vignette {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 300px;
    background-image: url("Art/Prep_Fade.png");
    background-size: 100% 100%;
    opacity: 0.5;
}

.lb-hud-panel {
    padding: 8px 16px;
}

.lb-hud-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.lb-hud-title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: rgb(244, 212, 140);
}

.lb-hud-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    background-size: contain;
}

.lb-hud-icon--ally { background-image: url("Art/Hud_IconAlly.png"); }
.lb-hud-icon--enemy { background-image: url("Art/Hud_IconEnemy.png"); }
.lb-hud-icon--wave { background-image: url("Art/Hud_IconWave.png"); }
.lb-hud-icon--food { background-image: url("Art/Growth_FoodProduction.png"); }

.lb-keycap {
    flex-shrink: 0;
    min-width: 24px;
    height: 24px;
    padding: 0 7px 2px 7px;
    align-items: center;
    justify-content: center;
}

.lb-keycap-text {
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 244, 248);
}

/* ---------- Gauges ---------- */

.lb-hud .lb-bar {
    margin: 2px 0;
    overflow: hidden;
}

.lb-hud .lb-bar-fill {
    background-size: 100% 100%;
    transition-property: width;
    transition-duration: 0.15s;
}

.lb-hud .lb-bar-text {
    font-size: 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.lb-bar--hp .lb-bar-fill { -unity-background-image-tint-color: rgb(228, 58, 60); }
.lb-bar--mana .lb-bar-fill { -unity-background-image-tint-color: rgb(66, 134, 255); }
.lb-bar--food .lb-bar-fill { -unity-background-image-tint-color: rgb(244, 182, 58); }
.lb-bar--ally .lb-bar-fill { -unity-background-image-tint-color: rgb(84, 150, 244); }
.lb-bar--enemy .lb-bar-fill { -unity-background-image-tint-color: rgb(214, 52, 64); }
.lb-bar--boss .lb-bar-fill { -unity-background-image-tint-color: rgb(206, 36, 72); }
.lb-hud .lb-bar--shielded .lb-bar-fill { -unity-background-image-tint-color: rgb(160, 104, 255); }
.lb-hud .lb-bar--shielded .lb-bar-text { color: rgb(236, 220, 255); }

/* ---------- Top bar ---------- */

.lb-top {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}

.lb-top-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 20px;
}

.lb-stage {
    margin: 0;
    padding: 0;
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 224, 150);
}

.lb-divider {
    width: 1px;
    height: 26px;
    margin: 0 14px;
    background-color: rgba(219, 174, 90, 0.4);
}

.lb-fronts {
    flex-direction: row;
    align-items: center;
}

.lb-front {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
    padding: 3px 12px 3px 3px;
    border-radius: 17px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

.lb-front-number {
    width: 26px;
    height: 26px;
    margin: 0 8px 0 0;
    padding: 0;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.45);
    background-color: rgb(16, 22, 40);
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(238, 232, 219);
}

.lb-front-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.lb-front-allies, .lb-front-enemies {
    min-width: 14px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.lb-front-allies {
    margin-right: 10px;
    color: rgb(168, 210, 255);
}

.lb-front-enemies {
    color: rgb(255, 146, 146);
}

.lb-front--contested {
    background-color: rgba(214, 150, 50, 0.2);
}

.lb-front--danger {
    background-color: rgba(196, 36, 50, 0.5);
    border-color: rgb(255, 112, 112);
}

.lb-front--selected {
    border-color: rgb(244, 204, 120);
}

.lb-front--selected .lb-front-number {
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    background-color: rgb(92, 64, 18);
    color: rgb(255, 240, 196);
}

.lb-waves {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.lb-bases {
    flex-direction: row;
    margin-top: 4px;
}

.lb-base {
    width: 280px;
    margin: 0 6px;
    padding: 7px 14px 9px 14px;
}

.lb-base-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.lb-base-head .lb-hud-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.lb-base-title {
    margin: 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.lb-base--ally .lb-base-title { color: rgb(176, 210, 255); }
.lb-base--enemy .lb-base-title { color: rgb(255, 156, 150); }

/* ---------- Boss ---------- */

.lb-boss {
    position: absolute;
    top: 150px;
    left: 32%;
    right: 32%;
    align-items: stretch;
}

.lb-boss-title {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
}

.lb-boss-title .lb-hud-icon {
    width: 22px;
    height: 22px;
}

.lb-boss-name {
    margin: 0 12px;
    padding: 0;
    font-size: 20px;
    letter-spacing: 4px;
    color: rgb(255, 176, 156);
}

/* ---------- Battlefield map (top left) ---------- */

.lb-minimap {
    position: absolute;
    left: 18px;
    top: 14px;
    width: 264px;
}

.lb-minimap-map {
    height: 270px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(219, 174, 90, 0.45);
    background-color: rgba(16, 30, 28, 0.8);
    overflow: hidden;
}

.lb-minimap-label {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    padding: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(238, 232, 219, 0.5);
    background-color: rgb(16, 24, 44);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(238, 232, 219, 0.75);
}

.lb-minimap-label--selected {
    border-width: 2px;
    border-color: rgb(255, 209, 97);
    background-color: rgb(70, 52, 16);
    color: rgb(255, 235, 180);
}

.lb-minimap-route {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.lb-route-caption {
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.6);
}

.lb-path-hint {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(255, 214, 120);
}

/* ---------- Hero vitals (bottom left) ---------- */

.lb-vitals {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 392px;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 12px 12px;
}

.lb-portrait {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    margin-right: 14px;
}

.lb-portrait-face {
    position: absolute;
    left: 11px;
    top: 11px;
    width: 90px;
    height: 90px;
    border-radius: 45px;
    overflow: hidden;
    background-color: rgb(30, 46, 92);
}

.lb-portrait-art {
    position: absolute;
    left: -121px;
    top: -22px;
    width: 333px;
    height: 699px;
    background-image: url("Art/Hero_Commander.png");
    background-size: 100% 100%;
}

.lb-level {
    position: absolute;
    left: -4px;
    bottom: -2px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(244, 204, 120);
    background-color: rgb(18, 28, 60);
    align-items: center;
    justify-content: center;
}

.lb-level-value {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(255, 238, 196);
}

.lb-gauges {
    flex-grow: 1;
}

.lb-hero-name {
    margin: 0 0 5px 2px;
    padding: 0;
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(244, 212, 140);
}

.lb-vital-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.lb-vital-label {
    width: 30px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.8);
}

.lb-vital-row .lb-bar {
    flex-grow: 1;
}

.lb-hud .lb-bar--hp .lb-bar-text {
    font-size: 13px;
}

/* ---------- Command bar (bottom centre) ---------- */

.lb-command {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    align-items: center;
}

.lb-abilities {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.lb-slot {
    width: 160px;
    align-items: center;
    margin: 0 2px;
}

.lb-socket-orb {
    width: 96px;
    height: 96px;
}

.lb-orb, .lb-orb-dial {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 72px;
    height: 72px;
}

.lb-orb {
    border-radius: 36px;
    background-color: rgb(10, 14, 28);
    background-size: 100% 100%;
}

.lb-orb-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.lb-orb-key {
    position: absolute;
    bottom: -9px;
    left: 50%;
    translate: -50% 0;
}

.lb-slot-caption {
    flex-direction: row;
    align-items: center;
    margin-top: 13px;
    padding: 2px 9px;
    border-radius: 9px;
    background-color: rgba(5, 8, 18, 0.72);
}

.lb-name {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.lb-cost {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(132, 178, 255);
}
.lb-slot--passive .lb-cost { color: rgba(238, 232, 219, 0.5); }
.lb-slot--cooling .lb-name { color: rgba(238, 232, 219, 0.55); }
.lb-slot--nomana .lb-orb { -unity-background-image-tint-color: rgb(150, 156, 196); }
.lb-slot--nomana .lb-cost { color: rgb(255, 118, 118); }

/* ---------- Troop roster (right edge) ----------
   One row per troop: framed portrait, name and Food cost. The portrait shade drains from the top as Food builds up. */

.lb-troops {
    position: absolute;
    right: 18px;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: flex-end;
}

.lb-card {
    width: 232px;
    height: 88px;
    margin: 3px 0;
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 7px;
    transition-property: translate;
    transition-duration: 0.15s;
}

.lb-card-portrait {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    margin-right: 12px;
}

.lb-card-body {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 3px;
    border-radius: 5px;
    overflow: hidden;
    background-color: rgb(22, 34, 66);
}

.lb-card-art {
    position: absolute;
    left: -32%;
    right: -32%;
    top: 2px;
    height: 200px;
    background-size: cover;
    background-position-x: center;
    background-position-y: top;
}

.lb-card--0 .lb-card-art { background-image: url("Art/Unit_Swordsman.png"); }
.lb-card--1 .lb-card-art { background-image: url("Art/Unit_Archer.png"); }
.lb-card--2 .lb-card-art { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-card--3 .lb-card-art { background-image: url("Art/Unit_Spearman.png"); }
.lb-card--4 .lb-card-art { background-image: url("Art/Unit_Priest.png"); }
.lb-card--5 .lb-card-art { background-image: url("Art/Unit_Mage.png"); }
.lb-card--6 .lb-card-art { background-image: url("Art/Unit_Knight.png"); }
.lb-card--7 .lb-card-art { background-image: url("Art/Unit_Dragon.png"); left: -60%; right: -20%; height: 110px; background-position-x: right; }

.lb-card-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background-color: rgba(4, 6, 16, 0.74);
    border-bottom-width: 1px;
    border-color: rgba(255, 214, 130, 0.7);
}

.lb-card-key {
    position: absolute;
    left: -6px;
    top: -6px;
    min-width: 22px;
    height: 22px;
}

.lb-card-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.lb-card-name {
    margin: 0 0 3px 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: rgba(238, 232, 219, 0.65);
}

.lb-card-price {
    flex-direction: row;
    align-items: center;
}

.lb-card-food {
    width: 20px;
    height: 20px;
    margin-right: 5px;
}

.lb-card-cost {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.55);
}
.lb-card--ready .lb-card-name { color: rgb(255, 250, 240); }
.lb-card--ready .lb-card-cost { color: rgb(255, 214, 120); }
.lb-card--ready .lb-card-shade { border-bottom-width: 0; }

.lb-card--selected {
    translate: -14px 0;
}

/* ---------- Misc ---------- */

.lb-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: rgba(255, 250, 240, 0.6);
    align-items: center;
    justify-content: center;
}

.lb-crosshair-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 250, 240, 0.95);
}

.lb-toast {
    position: absolute;
    bottom: 190px;
    left: 50%;
    width: 640px;
    height: 46px;
    margin: 0 0 0 -320px;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 245, 225);
}

.lb-hints {
    position: absolute;
    right: 18px;
    bottom: 18px;
    align-items: flex-end;
    padding: 4px 14px 10px 4px;
}

.lb-hint-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.lb-hint-row .lb-keycap {
    height: 22px;
    min-width: 22px;
}

.lb-hint-text {
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 12px;
    color: rgba(238, 232, 219, 0.8);
}

.lb-hint-row .lb-keycap {
    margin-left: 12px;
}

.lb-healthbars {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lb-unit-bar {
    position: absolute;
    width: 40px;
    height: 6px;
    margin-left: -20px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
    background-color: rgba(0, 0, 0, 0.6);
}

.lb-unit-bar-fill {
    height: 100%;
    background-size: 100% 100%;
}

.lb-unit-bar--ally .lb-unit-bar-fill { -unity-background-image-tint-color: rgb(110, 196, 255); }
.lb-unit-bar--enemy .lb-unit-bar-fill { -unity-background-image-tint-color: rgb(236, 70, 80); }

/* ---------- Overlays: level-up and result ---------- */

.lb-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 18, 0.62);
    align-items: center;
    justify-content: center;
}

.lb-title--defeat {
    color: rgb(230, 110, 110);
}

.lb-stats {
    align-self: stretch;
    margin: 6px 0 10px 0;
}

.lb-stat {
    font-size: 14px;
    white-space: normal;
}

.lb-ratings {
    flex-direction: row;
    margin: 4px 0 8px 0;
}

.lb-rating {
    width: 44px;
    height: 32px;
    margin: 0 3px;
    background-color: rgba(30, 44, 84, 0.95);
    border-color: rgba(219, 174, 90, 0.5);
    color: rgb(238, 232, 219);
}

.lb-rating--on {
    background-color: rgb(212, 168, 74);
    color: rgb(20, 20, 30);
}

.lb-note {
    align-self: stretch;
    min-height: 60px;
    margin-bottom: 10px;
}

/* ---------- Shared display text, ornaments and equipment icons ---------- */

.lb-display {
    -unity-font-definition: url("Fonts/NanumGothic-Regular.ttf");
    -unity-font-style: bold;
}

.lb-icon {
    width: 48px;
    height: 48px;
    background-size: contain;
}

.lb-icon--0 { background-image: url("Art/Item_LightStaff.png"); }
.lb-icon--1 { background-image: url("Art/Item_HealingStaff.png"); }
.lb-icon--2 { background-image: url("Art/Item_RuneStaff.png"); }
.lb-icon--3 { background-image: url("Art/Item_FoodRing.png"); }
.lb-icon--4 { background-image: url("Art/Item_ManaRing.png"); }
.lb-icon--5 { background-image: url("Art/Item_VitalityRing.png"); }

/* ---------- Level-up blessings ----------
   Full-screen overlay above the paused battle: three large cards dealt in by LevelUpView.
   Card frame and growth icons come from Lightbringer/UI/Build Preparation Art. */

.lb-levelup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    color: rgb(238, 232, 219);
}

.lb-levelup-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lb-levelup-header {
    align-items: center;
}

.lb-levelup-title-row {
    flex-direction: row;
    align-items: center;
}

.lb-levelup-title {
    margin: 0 26px;
    padding: 0;
    font-size: 72px;
    letter-spacing: 10px;
    color: rgb(250, 222, 150);
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.8);
}

.lb-levelup-subtitle {
    margin: 4px 0 0 0;
    padding: 0;
}

.lb-levelup-remaining {
    margin: 10px 0 0 0;
    padding: 4px 14px;
    border-width: 1px;
    font-size: 13px;
    -unity-font-style: bold;
}

.lb-lvcards {
    flex-direction: row;
    justify-content: center;
}

.lb-lvcard {
    width: 420px;
    height: 600px;
    margin: 0;
    padding: 58px 34px 26px 34px;
    align-items: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(238, 232, 219);
    transition-property: scale, translate, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.lb-lvcard:hover {
    scale: 1.035 1.035;
    translate: 0 -10px;
    background-color: rgba(0, 0, 0, 0);
}

.lb-lvcard:active {
    scale: 1.0 1.0;
    translate: 0 -4px;
}

/* Selected card stays raised with a full halo until CONFIRM; the other two step back. */
.lb-lvcard--selected, .lb-lvcard--selected:hover {
    scale: 1.05 1.05;
    translate: 0 -16px;
}

.lb-lvcard--selected .lb-lvcard-medal {
    background-color: rgb(196, 150, 64);
    border-color: rgb(255, 244, 205);
}

.lb-lvcard--dimmed {
    opacity: 0.5;
}

.lb-lvcard--dimmed:hover {
    opacity: 0.85;
}

.lb-lvcard-medal {
    position: absolute;
    left: 50%;
    top: -30px;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(24, 36, 72);
    align-items: center;
    justify-content: center;
}

.lb-lvcard:hover .lb-lvcard-medal {
    background-color: rgb(40, 66, 146);
    border-color: rgb(255, 236, 180);
}

.lb-lvcard-number {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: rgb(255, 240, 200);
    -unity-text-align: middle-center;
}

.lb-lvcard-category {
    margin: 0;
    padding: 0;
    font-size: 13px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.lb-lvcard-well {
    width: 196px;
    height: 196px;
    margin: 10px 0 8px 0;
    align-items: center;
    justify-content: center;
}

.lb-growth-icon {
    width: 150px;
    height: 150px;
    background-size: contain;
}

.lb-growth-icon--AuraSize { background-image: url("Art/Growth_AuraSize.png"); }
.lb-growth-icon--FoodProduction { background-image: url("Art/Growth_FoodProduction.png"); }
.lb-growth-icon--ManaRecovery { background-image: url("Art/Growth_ManaRecovery.png"); }
.lb-growth-icon--Capacity { background-image: url("Art/Growth_Capacity.png"); }
.lb-growth-icon--Leadership { background-image: url("Art/Growth_Leadership.png"); }
.lb-growth-icon--AuraBuff { background-image: url("Art/Growth_AuraBuff.png"); }
.lb-growth-icon--HeroPower { background-image: url("Art/Growth_HeroPower.png"); }
.lb-growth-icon--HeroVitality { background-image: url("Art/Growth_HeroVitality.png"); }

.lb-lvcard-title {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 30px;
    letter-spacing: 1px;
    color: rgb(250, 222, 150);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-lvcard-description {
    min-height: 52px;
    margin: 0;
    padding: 0;
    font-size: 17px;
    color: rgba(238, 232, 219, 0.82);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-lvcard-effect {
    margin: 12px 0 0 0;
    padding: 0;
    font-size: 23px;
    -unity-text-align: middle-center;
}

.lb-lvcard-footer {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 26px;
    height: 40px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-color: rgba(240, 205, 128, 0.3);
}

.lb-lvcard-rank {
    margin: 0;
    padding: 0;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(238, 232, 219, 0.6);
}

.lb-lvcard-total {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(250, 222, 150);
}
.lb-lvcard--aura .lb-lvcard-category, .lb-lvcard--aura .lb-lvcard-effect { color: rgb(255, 210, 120); }
.lb-lvcard--supply .lb-lvcard-category, .lb-lvcard--supply .lb-lvcard-effect { color: rgb(160, 230, 130); }
.lb-lvcard--magic .lb-lvcard-category, .lb-lvcard--magic .lb-lvcard-effect { color: rgb(140, 185, 255); }
.lb-lvcard--command .lb-lvcard-category, .lb-lvcard--command .lb-lvcard-effect { color: rgb(195, 165, 255); }
.lb-lvcard--hero .lb-lvcard-category, .lb-lvcard--hero .lb-lvcard-effect { color: rgb(255, 150, 135); }

.lb-levelup-prompt {
    align-items: center;
}

.lb-levelup-prompt-hint {
    margin: 6px 0 0 0;
    padding: 0;
}

.lb-levelup-confirm {
    width: 340px;
    height: 62px;
    margin: 16px 0 0 0;
    padding: 0;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(240, 205, 128);
    background-color: rgb(40, 66, 146);
    font-size: 24px;
    letter-spacing: 6px;
    color: rgb(255, 246, 225);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.lb-levelup-confirm:hover {
    background-color: rgb(56, 88, 186);
    border-color: rgb(255, 232, 170);
    scale: 1.03 1.03;
}

.lb-levelup-confirm:active {
    background-color: rgb(32, 54, 120);
    scale: 0.99 0.99;
}

.lb-levelup-confirm:disabled {
    background-color: rgb(30, 36, 56);
    border-color: rgba(238, 232, 219, 0.2);
    color: rgba(238, 232, 219, 0.4);
    opacity: 1;
    scale: 1 1;
}

/* Destination briefing. Quiet surfaces and typography carry the hierarchy; gold marks decisions. */
.lb-brief { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(10, 17, 21); color: rgb(223, 226, 217); }
.lb-brief-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("Art/CampaignAtlas_v1.png"); background-size: cover; -unity-background-image-tint-color: rgb(35, 45, 49); opacity: 0.22; }
.lb-brief-header { position: absolute; left: 64px; right: 64px; top: 40px; height: 82px; flex-direction: row; justify-content: space-between; align-items: center; }
.lb-brief-eyebrow { font-size: 12px; letter-spacing: 2px; color: rgb(181, 171, 141); margin: 0; padding: 0; }
.lb-brief-title { font-size: 32px; letter-spacing: 1px; margin: 12px 0 0 0; padding: 0; color: rgb(235, 235, 220); }
.lb-brief-back, .lb-brief-text-button { border-radius: 2px; border-width: 1px; border-color: rgba(183, 185, 164, 0.24); background-color: rgba(21, 31, 35, 0.8); color: rgb(196, 201, 186); font-size: 14px; padding: 10px 18px; margin: 0; }
.lb-brief-back:hover, .lb-brief-back:focus, .lb-brief-text-button:hover, .lb-brief-text-button:focus { border-color: rgb(196, 179, 133); background-color: rgb(37, 45, 46); color: rgb(235, 222, 187); }
.lb-brief-body { position: absolute; left: 64px; right: 64px; top: 151px; bottom: 140px; flex-direction: row; }
.lb-brief-mission { width: 31%; padding-right: 38px; border-right-width: 1px; border-right-color: rgba(183, 185, 164, 0.17); }
.lb-brief-armory { flex-grow: 1; flex-basis: 0; margin-left: 46px; }
.lb-brief .unity-scroll-view__content-container { flex-shrink: 0; }
.lb-brief-landscape { height: 172px; flex-shrink: 0; background-image: url("Art/CampaignAtlas_v1.png"); background-size: cover; -unity-background-image-tint-color: rgb(91, 106, 110); padding: 23px 26px; margin-bottom: 8px; border-width: 1px; border-color: rgba(198, 191, 160, 0.25); }
.lb-brief-destination { font-size: 46px; color: rgb(244, 239, 216); margin: 6px 0; padding: 0; }
.lb-brief-tag { font-size: 13px; color: rgb(200, 198, 175); margin: 0; padding: 0; }
.lb-brief-section { font-size: 12px; letter-spacing: 1px; color: rgb(166, 169, 152); margin: 20px 0 10px 0; padding: 0; }
.lb-brief-objective { font-size: 20px; color: rgb(225, 229, 216); white-space: normal; margin: 0; padding: 0; }
.lb-brief-metrics { flex-direction: row; margin: 22px 0 0 0; padding-bottom: 14px; border-bottom-width: 1px; border-bottom-color: rgba(180, 185, 168, 0.16); }
.lb-brief-metric { width: 50%; }
.lb-brief-metric-value { font-size: 25px; color: rgb(205, 203, 178); margin: 5px 0 0 0; padding: 0; }
.lb-brief-enemies { flex-direction: row; flex-wrap: wrap; }
.lb-brief-enemy { font-size: 14px; color: rgb(191, 199, 188); border-bottom-width: 1px; border-bottom-color: rgba(171, 156, 130, 0.35); padding: 4px 0 6px 0; margin: 0 18px 5px 0; }
.lb-brief-reward { flex-direction: row; align-items: center; min-height: 68px; background-color: rgba(44, 47, 39, 0.42); padding: 10px 12px; }
.lb-brief-reward .lb-icon { margin-right: 16px; }
.lb-brief-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.lb-brief-muted { font-size: 12px; color: rgb(149, 162, 159); white-space: normal; margin: 3px 0; padding: 0; -unity-text-align: middle-left; }
.lb-brief-identity { flex-direction: row; align-items: center; height: 77px; margin-bottom: 13px; border-bottom-width: 1px; border-bottom-color: rgba(180, 185, 168, 0.17); padding-bottom: 12px; }
.lb-brief-portrait { width: 62px; height: 64px; margin-right: 18px; background-image: url("Art/Hero_Commander.png"); background-size: 180% auto; background-position-x: center; background-position-y: top; -unity-background-image-tint-color: rgb(192, 199, 194); overflow: hidden; }
.lb-brief-hero-name { font-size: 17px; color: rgb(223, 225, 210); margin: 0 0 5px 0; padding: 0; }
.lb-brief-heading-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.lb-brief-heading { font-size: 23px; color: rgb(233, 232, 213); margin: 0; padding: 0; }
.lb-brief-slots { flex-direction: row; margin-bottom: 17px; }
.lb-brief-slot { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; height: 85px; margin: 0 10px 0 0; padding: 13px 12px; border-width: 1px; border-radius: 2px; border-color: rgba(181, 189, 170, 0.2); background-color: rgba(25, 36, 39, 0.72); }
.lb-brief-slot--active { border-color: rgb(196, 179, 133); background-color: rgb(40, 45, 41); }
.lb-brief-slot:hover, .lb-brief-slot:focus { border-color: rgb(211, 202, 166); }
.lb-brief-key { font-size: 11px; color: rgb(191, 183, 151); margin: 0 10px 0 0; padding: 0; min-width: 16px; }
.lb-brief-slot .lb-icon { width: 42px; height: 48px; flex-shrink: 0; margin-right: 10px; }
.lb-brief-item-name { font-size: 15px; color: rgb(222, 225, 209); white-space: normal; margin: 0 0 4px 0; padding: 0; -unity-text-align: middle-left; }
.lb-brief-inventory-hint { font-size: 12px; color: rgb(156, 171, 165); margin: 0 0 12px 0; padding: 0; }
.lb-brief-inventory { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.lb-brief-item { width: 32.4%; height: 78px; margin: 0 0.9% 9px 0; padding: 10px 14px; flex-direction: row; align-items: center; border-width: 1px; border-radius: 2px; border-color: rgba(156, 174, 159, 0.16); background-color: rgba(20, 31, 34, 0.7); }
.lb-brief-item .lb-icon { width: 42px; height: 46px; flex-shrink: 0; margin-right: 15px; }
.lb-brief-item:hover, .lb-brief-item:focus { border-color: rgb(181, 188, 159); background-color: rgb(34, 46, 46); }
.lb-brief-item--selected { border-color: rgb(175, 158, 114); background-color: rgb(38, 43, 37); }
.lb-brief-item:disabled { opacity: 0.58; }
.lb-brief-inspect { flex-direction: row; align-items: center; min-height: 137px; padding: 17px 20px; border-top-width: 1px; border-top-color: rgba(194, 179, 134, 0.5); background-color: rgba(29, 37, 35, 0.85); }
.lb-brief-inspect .lb-brief-detail-icon { width: 60px; height: 82px; margin-right: 24px; flex-shrink: 0; }
.lb-brief-item-title { font-size: 21px; color: rgb(233, 221, 184); margin: 3px 0 8px 0; padding: 0; }
.lb-brief-effect { font-size: 13px; color: rgb(184, 197, 188); white-space: normal; margin: 0; padding: 0; }
.lb-brief-item-stats { font-size: 12px; color: rgb(155, 174, 172); margin: 7px 0 0 0; padding: 0; }
.lb-brief-equip { min-width: 146px; height: 42px; font-size: 13px; color: rgb(226, 214, 173); border-width: 1px; border-color: rgb(156, 143, 109); border-radius: 2px; background-color: rgb(44, 48, 38); margin-left: 18px; }
.lb-brief-equip:hover, .lb-brief-equip:focus { background-color: rgb(66, 68, 48); border-color: rgb(221, 204, 151); }
.lb-brief-equip:disabled { opacity: 0.45; }
.lb-brief-feedback { height: 24px; margin: 7px 0 0 0; padding: 0; font-size: 12px; color: rgb(194, 201, 160); }
.lb-brief-roster { position: absolute; left: 64px; right: 64px; bottom: 119px; height: 122px; border-top-width: 1px; border-top-color: rgba(188, 189, 167, 0.18); }
.lb-brief-roster-heading { flex-direction: row; align-items: center; justify-content: space-between; height: 42px; }
.lb-brief-roster-heading .lb-brief-section { margin: 0; }
.lb-brief-troops { flex-direction: row; }
.lb-brief-troop { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; height: 73px; margin-right: 8px; background-color: rgba(26, 36, 37, 0.45); }
.lb-brief-unit-art { width: 68px; height: 68px; flex-shrink: 0; margin-right: 10px; background-size: cover; background-position-y: top; -unity-background-image-tint-color: rgb(183, 195, 184); }
.lb-brief-troop-name { font-size: 14px; color: rgb(202, 211, 194); margin: 0 0 3px 0; padding: 0; }
.lb-brief-troop-role { font-size: 11px; color: rgb(144, 160, 151); margin: 0 0 3px 0; padding: 0; }
.lb-brief-troop-cost { font-size: 11px; color: rgb(153, 174, 163); margin: 0; padding: 0; }
.lb-brief-troop--locked { opacity: 0.5; }
.lb-brief-unit--0 .lb-brief-unit-art { background-image: url("Art/Unit_Swordsman.png"); }
.lb-brief-unit--1 .lb-brief-unit-art { background-image: url("Art/Unit_Archer.png"); }
.lb-brief-unit--2 .lb-brief-unit-art { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-brief-unit--3 .lb-brief-unit-art { background-image: url("Art/Unit_Spearman.png"); }
.lb-brief-unit--4 .lb-brief-unit-art { background-image: url("Art/Unit_Priest.png"); }
.lb-brief-unit--5 .lb-brief-unit-art { background-image: url("Art/Unit_Mage.png"); }
.lb-brief-unit--6 .lb-brief-unit-art { background-image: url("Art/Unit_Knight.png"); }
.lb-brief-unit--7 .lb-brief-unit-art { background-image: url("Art/Unit_Dragon.png"); }
.lb-brief-footer { position: absolute; left: 64px; right: 64px; bottom: 30px; height: 69px; flex-direction: row; align-items: center; justify-content: space-between; border-top-width: 1px; border-top-color: rgba(198, 184, 143, 0.32); padding-top: 14px; }
.lb-brief-footer .lb-brief-muted { flex-shrink: 1; margin-right: 30px; }
.lb-brief .lb-brief-start { width: 340px; height: 52px; flex-shrink: 0; }
.lb-brief-growth-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(3, 8, 11, 0.86); align-items: center; justify-content: center; }
.lb-brief-growth-dialog { width: 660px; max-height: 78%; padding: 32px; background-color: rgb(19, 29, 32); border-width: 1px; border-color: rgba(195, 181, 139, 0.6); }
.lb-brief-growth-list { margin-top: 22px; flex-shrink: 1; }
.lb-brief-growth-row { font-size: 16px; white-space: normal; color: rgb(214, 219, 202); padding: 15px 0; border-bottom-width: 1px; border-bottom-color: rgba(166, 181, 163, 0.17); }

/* Unified in-game presentation: matte charcoal, ivory type, brass only for selection. */
.lb-hud .lb-display, .lb-levelup .lb-display { -unity-font-definition: url("Fonts/NanumGothic-Regular.ttf"); }
.lb-hud-panel, .lb-hud-frame { background-image: none; background-color: rgba(10, 20, 23, 0.88); border-width: 1px; border-color: rgba(182, 190, 171, 0.24); border-radius: 2px; }
.lb-hud-frame { padding: 12px; }
.lb-hud .lb-hud-title { color: rgb(199, 208, 190); font-size: 12px; letter-spacing: 1px; }
.lb-hud .lb-keycap { background-image: none; background-color: rgb(25, 36, 39); border-width: 1px; border-color: rgba(199, 205, 185, 0.42); border-radius: 2px; padding: 0 6px; }
.lb-hud .lb-bar { background-image: none; background-color: rgb(9, 16, 20); border-width: 1px; border-color: rgba(190, 201, 181, 0.25); border-radius: 1px; height: 18px; }
.lb-hud .lb-bar-fill, .lb-unit-bar-fill { background-image: none; border-radius: 0; }
.lb-hud .lb-bar--hp .lb-bar-fill { background-color: rgb(133, 64, 65); }
.lb-hud .lb-bar--mana .lb-bar-fill { background-color: rgb(65, 103, 134); }
.lb-hud .lb-bar--food .lb-bar-fill { background-color: rgb(145, 126, 69); }
.lb-hud .lb-bar--ally .lb-bar-fill { background-color: rgb(70, 111, 132); }
.lb-hud .lb-bar--enemy .lb-bar-fill, .lb-hud .lb-bar--boss .lb-bar-fill { background-color: rgb(150, 65, 68); }
.lb-hud .lb-bar--shielded .lb-bar-fill { background-color: rgb(101, 88, 133); }
.lb-unit-bar--ally .lb-unit-bar-fill { background-color: rgb(98, 165, 187); }
.lb-unit-bar--enemy .lb-unit-bar-fill { background-color: rgb(196, 91, 88); }
.lb-hud .lb-minimap { left: 32px; top: 28px; width: 230px; }
.lb-hud .lb-minimap-map { height: 195px; border-radius: 1px; border-color: rgba(186, 193, 165, 0.3); background-color: rgba(17, 32, 32, 0.8); }
.lb-hud .lb-path-hint { font-size: 15px; color: rgb(214, 200, 151); }
.lb-hud .lb-top { left: 280px; right: 245px; top: 28px; }
.lb-hud .lb-top-row { height: 44px; padding: 0 14px; }
.lb-hud .lb-stage { font-size: 16px; letter-spacing: 0; color: rgb(218, 216, 189); }
.lb-hud .lb-front { border-radius: 2px; padding: 3px 8px 3px 3px; margin: 0 3px; }
.lb-hud .lb-front-number { border-radius: 1px; background-color: rgb(23, 34, 37); width: 23px; height: 23px; margin-right: 5px; }
.lb-hud .lb-front--selected { border-color: rgb(199, 182, 127); }
.lb-hud .lb-front--selected .lb-front-number { border-width: 1px; background-color: rgb(70, 67, 44); border-color: rgb(180, 166, 113); }
.lb-hud .lb-front--danger { background-color: rgb(88, 37, 38); border-color: rgb(204, 107, 97); }
.lb-hud .lb-waves { font-size: 13px; }
.lb-hud .lb-divider { margin: 0 10px; background-color: rgba(201, 197, 163, 0.25); }
.lb-hud .lb-base { width: 258px; padding: 8px 12px; margin: 4px 4px 0 4px; }
.lb-hud .lb-base-head .lb-hud-icon { display: none; }
.lb-hud .lb-base-title { font-size: 11px; letter-spacing: 1px; }
.lb-hud .lb-boss { top: 165px; left: 35%; right: 35%; background-color: rgba(14, 21, 23, 0.86); padding: 10px 16px; }
.lb-hud .lb-boss-name { font-size: 16px; letter-spacing: 2px; }
.lb-hud .lb-boss-title .lb-hud-icon { display: none; }
.lb-hud .lb-boss .lb-bar { height: 18px; }
.lb-hud .lb-vitals { left: 32px; bottom: 32px; width: 350px; padding: 14px; }
.lb-hud .lb-portrait { width: 66px; height: 92px; margin-right: 14px; }
.lb-hud .lb-portrait-face { left: 0; top: 0; width: 66px; height: 70px; border-radius: 2px; background-color: rgb(26, 39, 39); }
.lb-hud .lb-portrait-art { left: -70px; top: -12px; width: 206px; height: 434px; }
.lb-hud .lb-level { left: 0; bottom: 0; width: 66px; height: 22px; border-width: 0; border-radius: 0; background-color: rgb(35, 43, 37); }
.lb-hud .lb-level-value { font-size: 12px; }
.lb-hud .lb-hero-name { font-size: 12px; letter-spacing: 0; color: rgb(204, 211, 185); }
.lb-hud .lb-bar--hp { height: 22px; }
.lb-hud .lb-command { left: 390px; right: 410px; bottom: 32px; }
.lb-hud .lb-slot { width: 132px; margin: 0 4px; }
.lb-hud .lb-socket-orb { width: 66px; height: 66px; border-width: 1px; border-color: rgba(199, 188, 146, 0.65); border-radius: 2px; background-color: rgba(12, 23, 26, 0.93); }
.lb-hud .lb-orb, .lb-hud .lb-orb-dial { left: 7px; top: 7px; width: 50px; height: 50px; }
.lb-hud .lb-orb { border-radius: 1px; background-color: rgba(0, 0, 0, 0); background-size: contain; }
.lb-hud .lb-orb--0 { background-image: url("Art/Item_LightStaff.png"); }
.lb-hud .lb-orb--1 { background-image: url("Art/Item_HealingStaff.png"); }
.lb-hud .lb-orb--2 { background-image: url("Art/Item_RuneStaff.png"); }
.lb-hud .lb-orb--3 { background-image: url("Art/Item_FoodRing.png"); }
.lb-hud .lb-orb--4 { background-image: url("Art/Item_ManaRing.png"); }
.lb-hud .lb-orb--5 { background-image: url("Art/Item_VitalityRing.png"); }
.lb-hud .lb-orb-key { bottom: -10px; }
.lb-hud .lb-slot-caption { flex-direction: column; border-radius: 2px; margin-top: 16px; padding: 5px 8px; background-color: rgba(10, 20, 23, 0.9); }
.lb-hud .lb-cost { margin: 3px 0 0 0; font-size: 11px; }
.lb-hud .lb-troops { right: 32px; top: 180px; bottom: 165px; }
.lb-hud .lb-card { width: 192px; height: 67px; padding: 5px 10px; margin: 3px 0; background-image: none; background-color: rgba(12, 23, 26, 0.9); border-width: 1px; border-color: rgba(166, 181, 164, 0.18); border-radius: 2px; }
.lb-hud .lb-card-portrait { width: 51px; height: 53px; margin-right: 12px; }
.lb-hud .lb-card-body { left: 0; right: 0; top: 0; bottom: 0; border-radius: 1px; background-color: rgb(25, 38, 37); }
.lb-hud .lb-card-art { height: 148px; }
.lb-hud .lb-card--7 .lb-card-art { height: 90px; }
.lb-hud .lb-card-name { font-size: 14px; }
.lb-hud .lb-card-cost { font-size: 13px; }
.lb-hud .lb-card--ready { border-color: rgba(183, 191, 151, 0.5); }
.lb-hud .lb-card--selected { translate: -6px 0; border-left-width: 3px; border-left-color: rgb(211, 194, 140); }
.lb-hud .lb-card-key { left: -7px; top: -3px; }
.lb-hud .lb-card-food { width: 15px; height: 15px; }
.lb-hud .lb-hints { right: 32px; bottom: 32px; padding: 8px 10px; }
.lb-hud .lb-hint-text { font-size: 10px; margin-left: 4px; }
.lb-hud .lb-hint-row .lb-keycap { margin-left: 7px; height: 20px; padding: 0 4px; }
.lb-hud .lb-keycap-text { font-size: 10px; }
.lb-hud .lb-toast { background-image: none; background-color: rgba(13, 23, 26, 0.94); border-bottom-width: 1px; border-bottom-color: rgb(185, 171, 124); height: 42px; bottom: 183px; font-size: 15px; }

/* Level-up comparison: a single row, restrained entrances and no rotating ornament. */
.lb-levelup { background-color: rgb(10, 18, 22); }
.lb-levelup-veil { background-color: rgba(10, 18, 22, 0.96); }
.lb-levelup-header { margin-bottom: 30px; }
.lb-levelup .lb-levelup-title { font-size: 42px; letter-spacing: 2px; color: rgb(234, 233, 215); text-shadow: none; margin: 0 0 14px 0; }
.lb-levelup-subtitle { font-size: 15px; letter-spacing: 0; color: rgb(158, 177, 170); -unity-font-style: normal; }
.lb-levelup-remaining { background-color: rgb(30, 43, 43); color: rgb(192, 195, 164); border-color: rgba(183, 190, 162, 0.3); border-radius: 1px; letter-spacing: 0; }
.lb-lvcards { width: 86%; max-width: 1240px; }
.lb-lvslot { flex-grow: 1; flex-basis: 0; margin: 0 10px; }
.lb-levelup .lb-lvcard { width: 100%; height: 465px; padding: 30px 28px; border-width: 1px; border-color: rgba(173, 191, 174, 0.3); border-radius: 2px; background-image: none; background-color: rgb(21, 32, 35); align-items: flex-start; }
.lb-levelup .lb-lvcard:hover, .lb-levelup .lb-lvcard:focus { scale: 1 1; translate: 0 -3px; background-color: rgb(29, 42, 43); border-color: rgb(184, 193, 160); }
.lb-levelup .lb-lvcard--selected, .lb-levelup .lb-lvcard--selected:hover { scale: 1 1; translate: 0 -3px; border-color: rgb(214, 195, 137); background-color: rgb(37, 43, 37); }
.lb-levelup .lb-lvcard--dimmed { opacity: 0.75; }
.lb-levelup .lb-lvcard-medal { left: auto; right: 24px; top: 22px; margin-left: 0; width: 30px; height: 30px; border-radius: 2px; border-width: 1px; border-color: rgba(185, 193, 164, 0.35); background-color: rgb(23, 35, 36); }
.lb-levelup .lb-lvcard-number { font-size: 13px; }
.lb-levelup .lb-lvcard-category { font-size: 12px; letter-spacing: 1px; color: rgb(184, 190, 163); }
.lb-levelup .lb-lvcard-well { width: 92px; height: 100px; margin: 20px 0 10px 0; }
.lb-levelup .lb-growth-icon { width: 88px; height: 88px; }
.lb-levelup .lb-lvcard-title { font-size: 25px; color: rgb(230, 232, 214); -unity-text-align: middle-left; margin: 4px 0 16px 0; letter-spacing: 0; }
.lb-levelup .lb-lvcard-description { font-size: 15px; -unity-text-align: upper-left; min-height: 54px; color: rgb(157, 177, 171); }
.lb-levelup .lb-lvcard-effect { font-size: 22px; color: rgb(217, 203, 157); -unity-text-align: middle-left; margin-top: 16px; }
.lb-levelup .lb-lvcard-footer { left: 28px; right: 28px; bottom: 22px; height: 50px; padding: 12px 0 0 0; flex-direction: column; align-items: flex-start; border-color: rgba(189, 191, 157, 0.24); }
.lb-levelup .lb-lvcard-total { font-size: 13px; color: rgb(201, 207, 178); white-space: normal; }
.lb-levelup .lb-lvcard-rank { font-size: 11px; letter-spacing: 0; }
.lb-levelup-prompt { margin-top: 24px; }
.lb-levelup-prompt-hint { font-size: 13px; letter-spacing: 0; color: rgb(154, 174, 165); }
.lb-levelup .lb-levelup-confirm { width: 300px; height: 52px; font-size: 17px; letter-spacing: 0; border-width: 1px; border-radius: 2px; background-color: rgb(195, 177, 130); border-color: rgb(211, 195, 154); color: rgb(21, 29, 30); text-shadow: none; }
.lb-levelup .lb-levelup-confirm:hover, .lb-levelup .lb-levelup-confirm:focus { scale: 1 1; background-color: rgb(221, 206, 164); }
.lb-levelup .lb-levelup-confirm:disabled { background-color: rgb(31, 43, 43); color: rgb(115, 131, 125); border-color: rgb(55, 70, 65); }

/* Pause and result share a quiet, readable modal language. */
.lb-flow { background-color: rgba(6, 14, 18, 0.96); color: rgb(220, 226, 211); }
.lb-flow-dialog { width: 850px; max-width: 90%; max-height: 92%; padding: 38px 48px; background-color: rgb(17, 28, 32); border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(193, 180, 137, 0.5); align-items: stretch; }
.lb-flow-eyebrow { font-size: 12px; letter-spacing: 2px; color: rgb(172, 182, 159); -unity-text-align: middle-center; margin-bottom: 15px; }
.lb-flow-title { font-size: 58px; color: rgb(228, 220, 181); -unity-text-align: middle-center; margin: 0 0 16px 0; -unity-font-style: normal; }
.lb-result--defeat .lb-flow-title { color: rgb(203, 147, 132); }
.lb-flow-description { font-size: 16px; color: rgb(164, 183, 174); white-space: normal; -unity-text-align: middle-center; margin: 0 0 28px 0; }
.lb-flow-muted { font-size: 13px; color: rgb(153, 173, 162); white-space: normal; }
.lb-result-summary { flex-direction: row; padding: 22px 0; border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(187, 193, 163, 0.2); }
.lb-result-metric { flex-grow: 1; flex-basis: 0; align-items: center; }
.lb-result-value { font-size: 30px; color: rgb(225, 229, 208); margin-top: 12px; }
.lb-result-details { margin: 20px 0 10px 0; color: rgb(162, 181, 171); font-size: 13px; }
.lb-result-scroll { max-height: 300px; }
.lb-result .lb-stat { font-size: 12px; color: rgb(163, 183, 172); margin-bottom: 8px; }
.lb-result .lb-caption { color: rgb(194, 201, 173); font-size: 12px; margin-top: 10px; letter-spacing: 0; }
.lb-result .lb-rating { background-color: rgb(27, 41, 43); border-width: 1px; border-color: rgb(78, 96, 84); border-radius: 2px; }
.lb-result .lb-rating--on { background-color: rgb(190, 174, 126); color: rgb(17, 28, 29); }
.lb-result .lb-note .unity-text-field__input { background-color: rgb(11, 22, 27); color: rgb(218, 227, 210); border-width: 1px; border-color: rgb(65, 85, 76); padding: 10px; }
.lb-flow .lb-flow-primary { width: 310px; flex-shrink: 0; align-self: center; margin-top: 20px; }
.lb-pause-dialog { width: 670px; }
.lb-pause-dialog .lb-flow-title { font-size: 44px; }
.lb-pause-volume-header { flex-direction: row; justify-content: space-between; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(183, 190, 158, 0.23); }
.lb-pause-volume { margin: 16px 0 22px 0; height: 24px; }
.lb-pause-volume .unity-base-field__label { display: none; }
.lb-pause-volume .unity-base-slider__tracker { height: 3px; background-color: rgb(61, 80, 72); }
.lb-pause-volume .unity-base-slider__dragger { width: 14px; height: 20px; border-radius: 2px; background-color: rgb(203, 188, 143); border-width: 0; }
.lb-pause-controls { font-size: 13px; color: rgb(162, 180, 167); white-space: normal; padding: 18px 0; border-top-width: 1px; border-top-color: rgba(183, 190, 158, 0.23); }
.lb-pause-credits { color: rgb(136, 157, 146); font-size: 12px; margin: 0 0 10px 0; }
.lb-flow-footnote { font-size: 12px; color: rgb(135, 158, 145); -unity-text-align: middle-center; margin-top: 14px; }

.lb-hidden {
    display: none;
}

/* ---------- Gold + troop upgrade ---------- */
.lb-coin { width: 18px; height: 18px; border-radius: 9px; background-color: rgb(233, 190, 86); border-width: 2px; border-color: rgb(255, 238, 178); margin-right: 9px; flex-shrink: 0; }
.lb-coin--large { width: 30px; height: 30px; border-radius: 15px; margin-right: 12px; }
.lb-upg-purse { flex-direction: row; align-items: center; padding: 7px 20px 7px 16px; background-color: rgba(7, 12, 19, 0.92); border-width: 1px; border-color: rgba(214, 178, 100, 0.55); border-radius: 2px; margin-right: 16px; }
.lb-upg-gold { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 22px; letter-spacing: 1px; color: rgb(246, 224, 160); }
.lb-brief-actions { flex-direction: row; align-items: center; }
.lb-brief-upgrade { margin-right: 16px; border-color: rgba(214, 178, 100, 0.6); color: rgb(244, 226, 170); }

.lb-upg { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.lb-upg-dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(6, 10, 15); }
.lb-upg-dialog { width: 1240px; height: 780px; max-width: 96%; max-height: 96%; padding: 36px 48px 34px 48px; background-color: rgb(9, 15, 23); border-width: 2px; border-color: rgb(190, 154, 80); border-radius: 3px; }
.lb-upg-inner { position: absolute; left: 6px; right: 6px; top: 6px; bottom: 6px; border-width: 1px; border-color: rgba(214, 178, 100, 0.22); }
.lb-upg-header { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 22px; }
.lb-upg-header-right { flex-direction: row; align-items: center; }
.lb-upg-eyebrow { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 12px; letter-spacing: 5px; color: rgb(196, 172, 120); }
.lb-upg-heading { font-size: 40px; letter-spacing: 3px; color: rgb(246, 232, 192); margin-top: 8px; }
.lb-upg-close { height: 40px; padding: 0 24px; margin: 0; background-color: rgba(21, 31, 44, 0.9); border-width: 1px; border-color: rgba(214, 178, 100, 0.5); border-radius: 2px; color: rgb(232, 218, 176); font-size: 15px; }
.lb-upg-close:hover, .lb-upg-close:focus { border-color: rgb(244, 222, 156); background-color: rgb(36, 46, 56); }
.lb-upg-body { flex-direction: row; flex-grow: 1; }
.lb-upg-grid { width: 574px; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.lb-upg-tile { width: 172px; height: 152px; margin: 0 14px 14px 0; padding: 0; background-color: rgb(15, 24, 35); border-width: 1px; border-color: rgba(214, 178, 100, 0.32); border-radius: 3px; overflow: hidden; }
.lb-upg-tile:hover, .lb-upg-tile:focus { border-color: rgb(226, 200, 130); background-color: rgb(22, 34, 47); }
.lb-upg-tile--selected { border-width: 2px; border-color: rgb(244, 214, 128); background-color: rgb(28, 42, 58); }
.lb-upg-tile--locked { opacity: 0.45; }
.lb-upg-tile--maxed .lb-upg-tile-rank { color: rgb(255, 236, 160); }
.lb-upg-art { position: absolute; left: 0; right: 0; top: 0; height: 112px; background-size: cover; background-position-y: top; }
.lb-upg-tile-cost { position: absolute; left: 8px; top: 8px; min-width: 30px; padding: 2px 8px; -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 14px; color: rgb(246, 224, 160); background-color: rgba(5, 9, 14, 0.82); border-width: 1px; border-color: rgba(214, 178, 100, 0.55); border-radius: 2px; -unity-text-align: middle-center; }
.lb-upg-tile-rank { position: absolute; left: 0; right: 0; bottom: 0; height: 34px; -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 16px; letter-spacing: 1px; color: rgb(218, 196, 140); background-color: rgba(5, 9, 14, 0.88); border-top-width: 1px; border-color: rgba(214, 178, 100, 0.35); -unity-text-align: middle-center; }
.lb-upg-art--0 { background-image: url("Art/Unit_Swordsman.png"); }
.lb-upg-art--1 { background-image: url("Art/Unit_Archer.png"); }
.lb-upg-art--2 { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-upg-art--3 { background-image: url("Art/Unit_Spearman.png"); }
.lb-upg-art--4 { background-image: url("Art/Unit_Priest.png"); }
.lb-upg-art--5 { background-image: url("Art/Unit_Mage.png"); }
.lb-upg-art--6 { background-image: url("Art/Unit_Knight.png"); }
.lb-upg-art--7 { background-image: url("Art/Unit_Dragon.png"); }
.lb-upg-panel { flex-grow: 1; flex-basis: 0; padding: 26px 30px; background-color: rgba(18, 28, 41, 0.92); border-width: 1px; border-color: rgba(214, 178, 100, 0.45); border-radius: 3px; }
.lb-upg-panel-top { flex-direction: row; align-items: center; }
.lb-upg-portrait { width: 120px; height: 140px; margin-right: 24px; background-size: cover; background-position-y: top; background-color: rgb(8, 13, 20); border-width: 1px; border-color: rgb(214, 178, 100); border-radius: 3px; flex-shrink: 0; }
.lb-upg-identity { flex-grow: 1; }
.lb-upg-name { font-size: 32px; color: rgb(246, 232, 192); letter-spacing: 2px; }
.lb-upg-rank { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 14px; letter-spacing: 2px; color: rgb(196, 172, 120); margin-top: 6px; }
.lb-upg-pips { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lb-upg-pip { width: 10px; height: 10px; margin: 0 7px 6px 0; rotate: 45deg; background-color: rgb(26, 36, 48); border-width: 1px; border-color: rgba(214, 178, 100, 0.3); }
.lb-upg-pip--on { background-color: rgb(238, 200, 104); border-color: rgb(255, 236, 170); }
.lb-upg-stats { margin-top: 22px; padding: 14px 0; border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(214, 178, 100, 0.25); }
.lb-upg-stat { flex-direction: row; align-items: center; padding: 5px 0; }
.lb-upg-stat-name { width: 90px; font-size: 15px; color: rgb(168, 180, 186); }
.lb-upg-stat-now { width: 70px; -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 22px; color: rgb(232, 232, 218); }
.lb-upg-arrow { width: 34px; font-size: 16px; color: rgb(190, 160, 96); -unity-text-align: middle-center; }
.lb-upg-stat-next { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 22px; color: rgb(246, 220, 140); }
.lb-upg-role { margin-top: 16px; font-size: 14px; line-height: 20px; color: rgb(178, 190, 192); white-space: normal; min-height: 44px; }
.lb-upg-meters { margin-top: 10px; }
.lb-upg-meter { flex-direction: row; align-items: center; padding: 4px 0; }
.lb-upg-meter-name { width: 70px; font-size: 13px; color: rgb(150, 164, 170); }
.lb-upg-track { flex-grow: 1; height: 8px; background-color: rgb(6, 10, 15); border-width: 1px; border-color: rgba(214, 178, 100, 0.3); border-radius: 4px; }
.lb-upg-fill { height: 100%; background-color: rgb(226, 184, 88); border-radius: 3px; }
.lb-upg-buy { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 20px; }
.lb-upg-cost { flex-direction: row; align-items: center; }
.lb-upg-cost-value { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 30px; color: rgb(248, 226, 160); }
.lb-upg-cost--short .lb-upg-cost-value { color: rgb(236, 112, 118); }
.lb-upg-button { width: 250px; height: 56px; margin: 0; font-size: 18px; }
.lb-upg-feedback { margin-top: 10px; font-size: 13px; color: rgb(196, 224, 190); min-height: 18px; }

/* ---------- Title ---------- */
.lb-title { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; background-color: rgb(8, 12, 21); background-image: url("../Art/UI/MainMenu/Title_LastLight_Storybook_v2.png"); -unity-background-scale-mode: scale-and-crop; }
.lb-title-brand { position: absolute; left: 6%; top: 19%; width: 36%; height: 25%; max-width: 720px; }
.lb-title-eyebrow { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 12px; letter-spacing: 9px; color: rgba(168, 190, 222, 0.78); }
.lb-title-logo { width: 100%; height: 100%; background-image: url("../Art/UI/MainMenu/Lightbringer_Storybook_Logo_v1.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-title-rule { width: 420px; height: 1px; margin-top: 12px; background-color: rgba(250, 226, 160, 0.55); }
.lb-title-tagline { font-size: 18px; letter-spacing: 4px; color: rgba(214, 220, 232, 0.82); margin-top: 24px; }
.lb-title-menu { position: absolute; left: 8%; bottom: 14%; width: 320px; }
.lb-title-start { height: 58px; font-size: 20px; letter-spacing: 8px; margin: 0 0 22px 0; background-color: rgba(250, 226, 160, 0.08); border-width: 1px; border-color: rgba(250, 226, 160, 0.55); border-radius: 2px; color: rgb(252, 244, 220); -unity-text-align: middle-left; padding-left: 20px; }
.lb-title-start:hover, .lb-title-start:focus { background-color: rgba(250, 226, 160, 0.22); border-color: rgb(255, 236, 184); }
.lb-title-link { height: 40px; margin: 0 0 4px 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; color: rgba(190, 202, 222, 0.7); font-size: 15px; letter-spacing: 6px; -unity-text-align: middle-left; padding-left: 20px; }
.lb-title-link:hover, .lb-title-link:focus { color: rgb(255, 240, 200); background-color: rgba(0, 0, 0, 0); }
.lb-title-footer { position: absolute; left: 8%; bottom: 4%; font-size: 11px; letter-spacing: 2px; color: rgb(120, 134, 142); }
.lb-upg-footer { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 14px; border-top-width: 1px; border-color: rgba(214, 178, 100, 0.32); }
.lb-upg-footer-note { font-size: 13px; color: rgb(150, 164, 170); }
.lb-upg-start { width: 340px; height: 52px; margin: 0; }
