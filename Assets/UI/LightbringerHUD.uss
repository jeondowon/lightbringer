/* Lightbringer UI, styled after the prologue and title storybook paintings (Docs/ArtPass/ArtDirection_Storybook.md):
   matte ink-night paper, hand-ruled faded-gold lines, gold kept for light and focus; the battle minimap is a treasure
   map. The view code only depends on the class names.
   Chrome art: Assets/UI/Art/Chrome (Lightbringer/UI/Build UI Chrome Art). Portraits and icons: Assets/UI/Art.
   9-slice, tiled so the paper grain never stretches: Ui_Panel 32 px, Ui_Dialog 48 px, Ui_Card* 24 px (the Story*Slice
   constants in UiChromePainter.Storybook). Buttons are painted at their USS height (56, 44, 32, 48) and slice
   everything except a 2 px band, so keep those heights in sync with UiChromePainter.Catalog.
   Fonts (Lightbringer/UI/Build Storybook Fonts): Gowun Batang for text with its real Bold in the weight table,
   Song Myung for display titles, Nanum Gothic as the symbol fallback. */

/* Bundle the Korean fonts so player builds do not depend on OS fallback fonts. */
:root {
    /* Minimum authored text size is 13px at the 1920x1080 reference resolution. */
    font-size: 13px;
    -unity-font-definition: url("Fonts/GowunBatang.asset");
    --gold: rgb(220, 176, 116);
    --gold-bright: rgb(248, 210, 148);
    --gold-dim: rgba(220, 176, 116, 0.45);
    --gold-faint: rgba(181, 150, 114, 0.22);
    --ivory: rgb(234, 224, 202);
    --muted: rgb(198, 188, 170);
    --gold-text: rgb(234, 202, 154);
    --ink: rgb(58, 34, 16);
}

/* ---------- Boss cinematic and dialogue ---------- */

.lb-boss-cinematic { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12, 2, 24, 0.12); }
.lb-boss-letterbox { position: absolute; left: 0; right: 0; top: 0; height: 8%; background-color: rgba(3, 2, 8, 0.95); }
.lb-boss-chapter { position: absolute; left: 8%; right: 8%; bottom: 12%; font-size: 40px; letter-spacing: 5px; color: rgb(230, 212, 250); -unity-text-align: middle-center; text-shadow: 0 3px 12px rgb(0, 0, 0); }
.lb-boss-dialogue {
    position: absolute; left: 6%; right: 6%; bottom: 2%; padding: 22px 38px 20px 38px;
    background-image: url("Art/Chrome/Ui_Dialog.png"); background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-type: tiled;
    border-width: 0; -unity-font-definition: url("Fonts/GowunBatang.asset");
}
.lb-boss-speaker { font-size: 20px; -unity-font-style: bold; letter-spacing: 2px; color: var(--gold); margin-bottom: 8px; }
.lb-boss-line { font-size: 24px; white-space: normal; min-height: 50px; color: var(--ivory); }
.lb-boss-dialogue-controls { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 14px; }
.lb-boss-dialogue-count { font-size: 14px; letter-spacing: 2px; color: var(--muted); }
.lb-boss-dialogue .lb-boss-next { min-width: 232px; font-size: 16px; flex-shrink: 0; }
/* Locked while the retreat animates: a plain grey plate instead of a status caption. */
.lb-boss-dialogue .lb-boss-next:disabled { opacity: 1; background-image: url("Art/Chrome/Ui_BtnSecondary.png"); -unity-background-image-tint-color: rgb(120, 120, 120); color: rgb(128, 128, 128); }
.lb-boss-story { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(4, 3, 8); }
/* The finale speaks over the live battlefield so the Demon King in the sky stays visible. */
.lb-boss-story--live { background-color: rgba(0, 0, 0, 0); }
.lb-boss-story-caption { padding: 20px 38px 18px 38px; }
.lb-boss-story-caption .lb-boss-speaker { font-size: 20px; margin-bottom: 8px; }
.lb-boss-story-caption .lb-boss-line { font-size: 24px; min-height: 50px; }
.lb-boss-story-caption .lb-boss-dialogue-controls { margin-top: 8px; }

/* ---------- Prologue ---------- */

.lb-campaign-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-prologue { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(4, 6, 9); overflow: hidden; }
.lb-prologue-frame { position: absolute; }
.lb-prologue-picture { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-prologue-top { position: absolute; left: 4%; right: 4%; top: 3%; flex-direction: row; justify-content: space-between; align-items: center; }
.lb-prologue-top .lb-atlas-brand { margin-bottom: 0; }
.lb-prologue-caption-panel { position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 14% 26px 14%; background-color: rgba(4, 6, 9, 0.0); border-width: 0; }
.lb-prologue-caption { font-size: 26px; color: rgb(244, 238, 220); white-space: normal; -unity-text-align: middle-center; min-height: 76px; margin-bottom: 14px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95); }
.lb-prologue-controls { flex-direction: row; justify-content: center; align-items: center; }
.lb-prologue-controls .lb-prologue-button { width: 84px; flex-grow: 0; flex-shrink: 0; -unity-text-align: middle-center; }
.lb-prologue-progress { height: 30px; width: 58px; flex-grow: 0; flex-shrink: 0; margin: 0 6px; padding: 0; border-width: 0; font-size: 13px; color: rgb(190, 182, 160); -unity-text-align: middle-center; }
.lb-prologue-button { height: 30px; min-width: 84px; padding: 0 14px; margin: 0 6px; background-color: rgba(0, 0, 0, 0); border-width: 0 0 1px 0; border-color: rgba(197, 180, 140, 0.25); border-radius: 0; color: rgb(190, 182, 160); font-size: 13px; letter-spacing: 1px; }
.lb-prologue-button:hover { background-color: rgba(0, 0, 0, 0); border-color: rgb(226, 208, 160); color: rgb(246, 238, 214); }
.lb-prologue-button:disabled { opacity: 0.3; }
.lb-prologue-music { position: absolute; left: 4%; top: 9%; }
.lb-prologue-credits { background-color: rgba(7, 11, 17, 0.96); padding: 18px; color: rgb(216, 211, 192); font-size: 14px; }


/* ---------- Shared ---------- */

.lb-hidden { display: none; }
.lb-display { -unity-font-definition: url("Fonts/GowunBatang.asset"); -unity-font-style: bold; }

.lb-panel {
    background-image: url("Art/Chrome/Ui_Panel.png");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-type: tiled;
    background-color: rgba(0, 0, 0, 0);
    padding: 22px 26px;
}

.lb-rule { height: 24px; flex-shrink: 0; margin: 4px 0 12px 0; background-image: url("Art/Chrome/Ui_Divider.png"); -unity-background-scale-mode: scale-to-fit; }

/* Buttons: chamfered lacquer with gold rims. Primary carries warm gold type. */
.lb-atlas-primary, .lb-button {
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
    -unity-background-image-tint-color: rgb(228, 228, 228);
    transition-property: -unity-background-image-tint-color, color, translate;
    transition-duration: 0.12s;
}
.lb-atlas-primary {
    height: 56px;
    padding: 0 36px 2px 36px;
    background-image: url("Art/Chrome/Ui_BtnPrimary.png");
    -unity-slice-left: 30; -unity-slice-right: 30; -unity-slice-top: 27; -unity-slice-bottom: 27;
    color: var(--gold-bright);
    font-size: 19px;
    letter-spacing: 2px;
}
.lb-button {
    height: 44px;
    padding: 0 26px 1px 26px;
    background-image: url("Art/Chrome/Ui_BtnSecondary.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 21; -unity-slice-bottom: 21;
    color: var(--ivory);
    font-size: 15px;
    letter-spacing: 1px;
}
.lb-button--gold { background-image: url("Art/Chrome/Ui_BtnPrimary44.png"); color: var(--gold-bright); }
.lb-button--small {
    height: 32px;
    padding: 0 18px 1px 18px;
    background-image: url("Art/Chrome/Ui_BtnSecondary32.png");
    -unity-slice-left: 18; -unity-slice-right: 18; -unity-slice-top: 15; -unity-slice-bottom: 15;
    font-size: 13px;
}
.lb-button--back { min-width: 118px; font-size: 16px; }
.lb-atlas-primary:hover, .lb-atlas-primary:focus, .lb-button:hover, .lb-button:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 246, 222);
}
.lb-atlas-primary:active, .lb-button:active { -unity-background-image-tint-color: rgb(180, 180, 180); background-color: rgba(0, 0, 0, 0); translate: 0 1px; }
.lb-atlas-primary:disabled, .lb-button:disabled { opacity: 0.4; }

.lb-keycap {
    flex-shrink: 0;
    min-width: 24px;
    height: 24px;
    padding: 0 7px 1px 7px;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 30, 36);
    border-width: 1px 1px 3px 1px;
    border-color: var(--gold-dim);
    border-bottom-color: rgb(96, 72, 34);
    border-radius: 4px;
}
.lb-keycap-text { margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--ivory); }

.lb-coin { width: 24px; height: 24px; flex-shrink: 0; margin-right: 8px; background-image: url("Art/Chrome/Ui_Shard.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-coin--large { width: 36px; height: 36px; margin-right: 10px; }

.lb-icon { width: 48px; height: 48px; background-size: contain; }
.lb-icon--0 { background-image: url("Art/Skill_LightBeam.png"); }
.lb-icon--1 { background-image: url("Art/Skill_Heal.png"); }
.lb-icon--2 { background-image: url("Art/Skill_Ice.png"); }
.lb-icon--3 { background-image: url("Art/Skill_Shockwave.png"); }
.lb-icon--4 { background-image: url("Art/Skill_Meteor.png"); }
.lb-icon--shard { background-image: url("Art/Chrome/Ui_Shard.png"); -unity-background-scale-mode: scale-to-fit; }

.lb-caption { font-size: 13px; color: var(--muted); -unity-font-style: bold; letter-spacing: 1px; }

.lb-bar { height: 18px; margin: 2px 0; border-radius: 1px; background-color: rgb(16, 15, 18); border-width: 1px; border-color: rgba(181, 150, 114, 0.5); overflow: hidden; }
.lb-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background-image: url("Art/Chrome/Ui_Gloss.png"); -unity-background-scale-mode: stretch-to-fill; transition-property: width; transition-duration: 0.15s; }
.lb-bar-text { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; -unity-text-align: middle-center; font-size: 13px; -unity-font-style: bold; color: rgb(255, 250, 240); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95); }
.lb-bar--hp .lb-bar-fill { -unity-background-image-tint-color: rgb(178, 66, 56); }
.lb-bar--mana .lb-bar-fill { -unity-background-image-tint-color: rgb(88, 122, 182); }
.lb-bar--food .lb-bar-fill { -unity-background-image-tint-color: rgb(214, 164, 86); }
.lb-bar--ally .lb-bar-fill { -unity-background-image-tint-color: rgb(98, 132, 186); }
.lb-bar--enemy .lb-bar-fill { -unity-background-image-tint-color: rgb(178, 66, 56); }
.lb-bar--boss .lb-bar-fill { -unity-background-image-tint-color: rgb(152, 42, 62); }
.lb-bar--shielded .lb-bar-fill { -unity-background-image-tint-color: rgb(130, 106, 196); }
.lb-bar--shielded .lb-bar-text { color: rgb(236, 220, 255); }

/* ---------- Campaign map ---------- */
.lb-atlas { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(8, 14, 18); overflow: hidden; }
.lb-atlas-canvas { position: absolute; }
.lb-atlas-paper, .lb-atlas-roads { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-atlas-paper { background-image: url("Art/CampaignAtlas_Act1_v1.png"); -unity-background-scale-mode: stretch-to-fill; }
.lb-atlas--act2 .lb-atlas-paper { background-image: url("Art/CampaignAtlas_Act2_v2.png"); }
.lb-atlas--act3 .lb-atlas-paper { background-image: url("Art/CampaignAtlas_Act3_v2.png"); }
.lb-atlas-nav { position: absolute; top: 50%; width: 64px; height: 104px; margin: -52px 0 0 0; padding: 0; border-width: 0; border-radius: 4px; background-color: rgba(8, 14, 18, 0.25); color: rgb(212, 203, 178); font-size: 44px; -unity-text-align: middle-center; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9); transition-property: color, background-color; transition-duration: 0.18s; }
.lb-atlas-nav--previous { left: 24px; }
.lb-atlas-nav--next { right: 24px; }
.lb-atlas-nav:hover, .lb-atlas-nav:focus { color: rgb(255, 238, 194); background-color: rgba(22, 32, 34, 0.8); }
.lb-atlas-nav:active { background-color: rgba(45, 52, 48, 0.9); }
.lb-atlas-header { position: absolute; top: 42px; left: 64px; right: 64px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.lb-atlas-brand { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 14px; letter-spacing: 5px; color: rgb(188, 174, 140); margin-bottom: 15px; }
.lb-atlas-title { font-size: 32px; color: rgb(235, 234, 222); letter-spacing: 2px; }
.lb-atlas-subtitle { font-size: 14px; color: rgb(153, 168, 167); margin-top: 9px; }
.lb-atlas-progress { font-size: 14px; color: rgb(212, 203, 178); margin-top: 12px; letter-spacing: 1px; }
.lb-atlas-footer { position: absolute; left: 64px; right: 64px; bottom: 40px; padding: 18px 28px 20px 28px; background-color: rgba(0, 0, 0, 0); background-image: url("Art/Chrome/Ui_Panel.png"); -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-type: tiled; }
.lb-atlas-detail { flex-shrink: 1; align-items: center; }
.lb-atlas-eyebrow { font-size: 13px; letter-spacing: 2px; color: var(--gold); -unity-text-align: middle-center; }
.lb-atlas-selected { -unity-font-definition: url("Fonts/SongMyung.asset"); font-size: 27px; color: var(--ivory); margin-top: 4px; margin-bottom: 2px; -unity-text-align: middle-center; }
.lb-atlas-caption-rule { width: 240px; height: 16px; flex-shrink: 0; margin: 0 0 3px 0; background-image: url("Art/Chrome/Ui_Divider.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-atlas-description { font-size: 15px; color: var(--ivory); white-space: normal; -unity-text-align: middle-center; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8); }
.lb-atlas-hint { font-size: 13px; color: rgb(155, 165, 161); margin-bottom: 12px; -unity-text-align: middle-right; }
.lb-atlas-status { position: absolute; bottom: 8px; left: 64px; color: rgb(212, 184, 145); font-size: 13px; }
.lb-beacon { position: absolute; width: 132px; height: 136px; margin: -38px 0 0 -66px; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; align-items: center; transition-duration: 0.15s; transition-property: scale; }
.lb-beacon:hover, .lb-beacon:focus { scale: 1.06 1.06; background-color: rgba(0, 0, 0, 0); }
.lb-beacon--selected { scale: 1.16 1.16; background-color: rgba(0, 0, 0, 0); }
.lb-beacon--selected:hover, .lb-beacon--selected:focus { scale: 1.18 1.18; }
.lb-beacon:disabled { opacity: 0.85; }
.lb-beacon-symbol { width: 74px; height: 88px; flex-shrink: 0; background-image: url("Art/Chrome/Map_BeaconDark.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-beacon--ready .lb-beacon-symbol { background-image: url("Art/Chrome/Map_BeaconReady.png"); }
.lb-beacon--lit .lb-beacon-symbol { background-image: url("Art/Chrome/Map_BeaconLit.png"); }
.lb-beacon-light { position: absolute; left: 29px; top: 0; width: 74px; height: 88px; }
.lb-beacon-name { width: 112px; height: 28px; flex-shrink: 0; color: var(--ivory); font-size: 13px; margin: 2px 0 0 0; padding: 0 10px; background-color: rgba(0, 0, 0, 0); background-image: url("Art/Chrome/Ui_Tag.png"); -unity-background-scale-mode: stretch-to-fill; border-width: 0; -unity-text-align: middle-center; letter-spacing: 1px; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); }
.lb-beacon-state { color: var(--ivory); font-size: 13px; margin-top: 3px; -unity-text-align: middle-center; text-shadow: 0 1px 3px rgb(0, 0, 0); }
.lb-beacon--ready .lb-beacon-name, .lb-beacon--selected .lb-beacon-name { color: var(--gold-bright); background-image: url("Art/Chrome/Ui_TagActive.png"); }
.lb-beacon--ready .lb-beacon-state { color: var(--gold-bright); }
.lb-beacon--lit .lb-beacon-name, .lb-beacon--lit .lb-beacon-state { color: var(--gold); }

.lb-atlas-back { position: absolute; left: 48px; top: 40px; }
.lb-atlas .lb-atlas-header { left: 196px; }

/* ---------- Battle HUD ---------- */

.lb-hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--ivory); font-size: 16px; }
.lb-hud Label { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); }
.lb-hud-vignette { position: absolute; left: 0; right: 0; bottom: 0; height: 280px; background-image: url("Art/Prep_Fade.png"); background-size: 100% 100%; opacity: 0.55; }
.lb-hud-panel {
    background-image: url("Art/Chrome/Ui_Panel.png");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-type: tiled;
    padding: 12px 16px;
}
.lb-hud-icon { flex-shrink: 0; width: 20px; height: 20px; background-size: contain; }
.lb-hud-icon--ally { background-image: url("Art/Chrome/Ui_IconAlly.png"); }
.lb-hud-icon--enemy { background-image: url("Art/Chrome/Ui_IconEnemy.png"); }
.lb-hud-icon--wave { background-image: url("Art/Chrome/Ui_IconWave.png"); }
.lb-hud-icon--food { background-image: url("Art/Growth_FoodProduction.png"); }

/* Battlefield map (top left): a parchment page in a paper panel, titled above, the summon Path below it. The route strip
   is centred between the map and the panel's gold rule (about 11 px above the panel edge, inside the 12 px padding). */
.lb-minimap { position: absolute; left: 22px; top: 18px; width: 272px; padding: 12px 14px 12px 14px; align-items: center; }
.lb-minimap-title { margin: 4px 0 4px 0; padding: 0; -unity-font-definition: url("Fonts/SongMyung.asset"); -unity-font-style: normal; font-size: 17px; letter-spacing: 4px; color: var(--gold-bright); -unity-text-align: middle-center; }
.lb-minimap-sheet { width: 244px; height: 270px; flex-shrink: 0; background-image: url("Art/Chrome/Map_Parchment.png"); -unity-background-scale-mode: stretch-to-fill; }
.lb-minimap-compass { position: absolute; right: 9px; top: 9px; width: 30px; height: 30px; background-image: url("Art/Chrome/Map_Compass.png"); -unity-background-scale-mode: scale-to-fit; rotate: -12deg; }
.lb-minimap-map { position: absolute; left: 12px; right: 12px; top: 12px; bottom: 12px; }
.lb-minimap-label {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    padding: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgb(36, 20, 8);
    background-color: rgb(86, 58, 34);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(232, 214, 176);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
.lb-minimap-label--selected { border-color: rgb(80, 16, 6); background-color: rgb(150, 26, 12); color: rgb(255, 240, 214); }
.lb-minimap-route { flex-shrink: 0; align-self: stretch; height: 40px; flex-direction: row; justify-content: center; align-items: center; margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
/* One baseline across the strip. Gowun Batang sets a line box of 1.448 em with the baseline 1.16 em down, so a centred
   label's baseline sits 0.436 em below the row centre: 5.67 px for the 13 px caption and the TAB key (a 24 px cap with a
   plain 1 px gold rim and no padding), 6.98 px for the 16 px Path name, which is lifted the 1.31 px difference. */
.lb-route-caption { margin: 0 8px 0 0; padding: 0; font-size: 13px; color: var(--muted); }
.lb-path-hint { margin: 0 10px 0 0; padding: 0; font-size: 16px; color: var(--gold-bright); translate: 0 -1.31px; }
.lb-minimap-route .lb-keycap { padding: 0 7px; border-width: 1px; border-color: var(--gold-dim); }

/* Top: one ink band across the standoff, the stage seal at its centre, fronts underneath. */
.lb-top { position: absolute; top: 8px; left: 300px; right: 300px; align-items: center; }
.lb-top-row { flex-direction: row; align-items: center; height: 136px; padding: 0 72px; background-image: url("Art/Chrome/Ui_HudBanner.png"); -unity-background-scale-mode: stretch-to-fill; }
.lb-base { width: 330px; padding: 0 12px; }
.lb-base.lb-hud-panel { background-image: none; }
.lb-base .lb-bar { height: 20px; }
.lb-base .lb-bar-text { font-size: 13px; }
.lb-base-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.lb-base-title { margin: 0; padding: 0; font-size: 15px; letter-spacing: 3px; -unity-font-style: bold; }
.lb-base--ally .lb-base-title { color: rgb(160, 182, 214); }
.lb-base--enemy .lb-base-head { justify-content: flex-end; }
.lb-base--enemy .lb-base-title { color: rgb(222, 140, 128); }
.lb-top-centre { width: 150px; align-items: center; margin: 0 4px; }
/* Two lines from StageSealText: stage small in faded gold, the number large beneath it. */
.lb-stage { width: 136px; height: 136px; margin: 0; padding: 0 0 4px 0; background-image: url("Art/Chrome/Ui_Seal.png"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); border-radius: 0; -unity-text-align: middle-center; -unity-font-definition: url("Fonts/SongMyung.asset"); -unity-font-style: normal; font-size: 26px; color: var(--gold-bright); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); white-space: normal; }

/* Assault count and front chips: small paper tags with ink icons. */
.lb-wave-row, .lb-front {
    background-image: url("Art/Chrome/Ui_Tag.png");
    -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.lb-wave-row { flex-direction: row; align-items: center; margin-top: -26px; height: 28px; padding: 0 14px 1px 10px; }
.lb-wave-row .lb-hud-icon { width: 17px; height: 17px; margin-right: 6px; }
.lb-waves { margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: var(--ivory); }
.lb-fronts { flex-direction: row; align-items: center; margin-top: 4px; }
/* Front card: the Path seal drawn exactly like the minimap's route labels (red = the summon Path, as on the map),
   then our count and theirs either side of a tug-of-war gauge. */
.lb-front { flex-direction: row; align-items: center; height: 34px; margin: 0 4px; padding: 0 10px 1px 7px; }
.lb-front-number { width: 20px; height: 20px; margin: 0 8px 0 0; padding: 0; border-radius: 10px; border-width: 1px; border-color: rgb(36, 20, 8); background-color: rgb(86, 58, 34); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 12px; color: rgb(232, 214, 176); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.lb-front-icon { width: 16px; height: 16px; margin: 0 3px 0 0; }
.lb-front-allies, .lb-front-enemies { min-width: 14px; margin: 0; padding: 0; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.lb-front-allies { color: rgb(170, 190, 220); }
.lb-front-enemies { margin-right: 3px; color: rgb(226, 148, 134); }
.lb-front-tug { width: 46px; height: 8px; margin: 0 7px; background-color: rgb(16, 15, 18); border-width: 1px; border-color: rgba(181, 150, 114, 0.55); border-radius: 1px; overflow: hidden; }
.lb-front-push { position: absolute; top: 0; bottom: 0; width: 0; background-image: url("Art/Chrome/Ui_Gloss.png"); -unity-background-scale-mode: stretch-to-fill; transition-property: width; transition-duration: 0.3s; }
.lb-front-push--ally { left: 0; -unity-background-image-tint-color: rgb(98, 132, 186); }
.lb-front-push--enemy { right: 0; -unity-background-image-tint-color: rgb(178, 66, 56); }
/* The midline marks an even fight; whichever side pushes past it holds the front. */
.lb-front-tug-mid { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; margin-left: -0.5px; background-color: rgba(234, 224, 202, 0.7); }
.lb-front--contested { -unity-background-image-tint-color: rgb(255, 226, 180); }
.lb-front--selected { background-image: url("Art/Chrome/Ui_TagActive.png"); }
.lb-front--selected .lb-front-number { border-color: rgb(80, 16, 6); background-color: rgb(150, 26, 12); color: rgb(255, 240, 214); }
/* Danger outranks selection: the crimson tag stays visible even on the selected front. */
.lb-front--danger { background-image: url("Art/Chrome/Ui_TagAlert.png"); -unity-background-image-tint-color: rgb(255, 255, 255); }

.lb-boss { position: absolute; top: 196px; left: 31%; right: 31%; padding: 10px 20px 14px 20px; }
.lb-boss-title { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 4px; }
.lb-boss-ornament { width: 8px; height: 8px; rotate: 45deg; background-color: rgb(206, 60, 72); }
.lb-boss-name { margin: 0 14px; padding: 0; font-size: 16px; letter-spacing: 4px; color: rgb(255, 186, 166); }
.lb-boss .lb-bar { height: 20px; border-color: rgba(230, 100, 100, 0.6); }
/* Final battle: the Demon King (abyss core) bar sits under the Warlord's. */
.lb-boss--second { top: 252px; }

/* Hero vitals (bottom left). */
.lb-vitals { position: absolute; left: 22px; bottom: 20px; width: 410px; flex-direction: row; align-items: center; padding: 14px 20px 14px 14px; }
.lb-portrait { width: 100px; height: 100px; flex-shrink: 0; margin-right: 14px; }
.lb-portrait-face { position: absolute; left: 10px; top: 10px; width: 80px; height: 80px; border-radius: 40px; overflow: hidden; background-color: rgb(36, 36, 44); }
.lb-portrait-art { position: absolute; left: -80px; top: -13px; width: 240px; height: 504px; background-image: url("Art/Hero_Commander.png"); background-size: 100% 100%; }
.lb-portrait-ring { position: absolute; left: 0; top: 0; width: 100px; height: 100px; background-image: url("Art/Chrome/Ui_Medallion.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-level { position: absolute; left: -4px; bottom: -2px; width: 32px; height: 32px; border-radius: 16px; border-width: 2px; border-color: var(--gold); background-color: rgb(26, 24, 28); align-items: center; justify-content: center; }
.lb-level-value { margin: 0; padding: 0; font-size: 15px; -unity-text-align: middle-center; color: var(--gold-bright); }
.lb-gauges { flex-grow: 1; }
.lb-hero-name { margin: 0 0 6px 2px; padding: 0; font-size: 14px; letter-spacing: 2px; color: var(--gold-bright); }
.lb-vital-row { flex-direction: row; align-items: center; margin: 1px 0; }
.lb-vital-label { width: 34px; margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: var(--muted); }
.lb-vital-row .lb-bar { flex-grow: 1; }
.lb-bar--hp { height: 22px; }
.lb-bar--hp .lb-bar-text { font-size: 13px; }

/* Abilities (bottom centre). */
.lb-command { position: absolute; left: 450px; right: 450px; bottom: 20px; align-items: center; }
.lb-abilities { flex-direction: row; justify-content: center; align-items: flex-end; }
.lb-slot { width: 126px; align-items: center; margin: 0 4px; }
.lb-socket-orb { width: 88px; height: 88px; }
.lb-orb, .lb-orb-dial { position: absolute; left: 12px; top: 12px; width: 64px; height: 64px; }
.lb-orb { border-radius: 32px; background-color: rgb(20, 20, 26); background-size: cover; }
.lb-orb--0 { background-image: url("Art/Skill_LightBeam.png"); }
.lb-orb--1 { background-image: url("Art/Skill_Heal.png"); }
.lb-orb--2 { background-image: url("Art/Skill_Ice.png"); }
.lb-orb--3 { background-image: url("Art/Skill_Shockwave.png"); }
.lb-orb--4 { background-image: url("Art/Skill_Meteor.png"); }
.lb-orb-ring { position: absolute; left: 0; top: 0; width: 88px; height: 88px; background-image: url("Art/Chrome/Ui_Socket.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-orb-timer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; -unity-text-align: middle-center; font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.lb-orb-key { position: absolute; bottom: -8px; left: 50%; translate: -50% 0; }
.lb-slot-caption { align-items: center; margin-top: 14px; padding: 4px 12px 5px 12px; border-radius: 3px; background-color: rgba(18, 18, 23, 0.86); }
.lb-name { margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; white-space: nowrap; }
.lb-cost { margin: 2px 0 0 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: rgb(150, 172, 206); }
.lb-slot--passive .lb-cost { color: rgba(238, 232, 219, 0.5); }
.lb-slot--cooling .lb-name { color: rgba(238, 232, 219, 0.55); }
.lb-slot--nomana .lb-orb { -unity-background-image-tint-color: rgb(140, 146, 186); }
.lb-slot--nomana .lb-cost { color: rgb(255, 118, 118); }

/* Troop roster (right edge). The portrait shade drains from the top as Food builds up. */
.lb-troops { position: absolute; right: 22px; top: 186px; bottom: 150px; justify-content: center; align-items: flex-end; }
.lb-card {
    width: 214px;
    height: 66px;
    margin: 2px 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 6px 7px;
    background-image: url("Art/Chrome/Ui_Card.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-type: tiled;
    transition-property: translate;
    transition-duration: 0.15s;
}
.lb-card-portrait { width: 52px; height: 54px; flex-shrink: 0; margin-right: 12px; }
.lb-card-body { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-radius: 3px; overflow: hidden; background-color: rgb(30, 30, 36); }
.lb-card-art { position: absolute; left: -32%; right: -32%; top: 2px; height: 148px; background-size: cover; background-position-x: center; background-position-y: top; }
.lb-card--0 .lb-card-art { background-image: url("Art/Unit_Swordsman.png"); }
.lb-card--1 .lb-card-art { background-image: url("Art/Unit_Archer.png"); }
.lb-card--2 .lb-card-art { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-card--3 .lb-card-art { background-image: url("Art/Unit_Spearman.png"); }
.lb-card--4 .lb-card-art { background-image: url("Art/Unit_Priest.png"); }
.lb-card--5 .lb-card-art { background-image: url("Art/Unit_Mage.png"); }
.lb-card--6 .lb-card-art { background-image: url("Art/Unit_Knight.png"); }
.lb-card--7 .lb-card-art { background-image: url("Art/Unit_Dragon.png"); left: -60%; right: -20%; height: 90px; background-position-x: right; }
.lb-card-shade { position: absolute; left: 0; right: 0; top: 0; height: 0; background-color: rgba(4, 6, 16, 0.76); border-bottom-width: 1px; border-color: rgba(255, 214, 130, 0.7); }
.lb-card-key { position: absolute; left: -8px; top: -6px; min-width: 22px; height: 22px; }
.lb-card-info { flex-grow: 1; flex-shrink: 1; }
.lb-card-name { margin: 0 0 3px 0; padding: 0; font-size: 15px; -unity-font-style: bold; white-space: nowrap; color: rgba(238, 232, 219, 0.55); }
.lb-card-price { flex-direction: row; align-items: center; }
.lb-card-food { width: 15px; height: 15px; margin-right: 5px; }
.lb-card-cost { margin: 0; padding: 0; font-size: 14px; -unity-font-style: bold; color: rgba(238, 232, 219, 0.45); }
.lb-card--ready .lb-card-name { color: rgb(255, 250, 240); }
.lb-card--ready .lb-card-cost { color: var(--gold-bright); }
.lb-card--ready .lb-card-shade { border-bottom-width: 0; }
.lb-card--selected { translate: -12px 0; background-image: url("Art/Chrome/Ui_CardActive.png"); }

.lb-crosshair { position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin-left: -8px; margin-top: -8px; border-radius: 8px; border-width: 1.5px; border-color: rgba(255, 250, 240, 0.6); align-items: center; justify-content: center; }
.lb-crosshair-dot { width: 4px; height: 4px; border-radius: 2px; background-color: rgba(255, 250, 240, 0.95); }
.lb-toast { position: absolute; bottom: 196px; left: 50%; width: 640px; height: 44px; margin: 0 0 0 -320px; padding: 0 0 1px 0; background-image: url("Art/Chrome/Ui_Toast.png"); -unity-background-scale-mode: stretch-to-fill; -unity-text-align: middle-center; font-size: 17px; -unity-font-style: bold; color: var(--gold-bright); }
.lb-hints { position: absolute; right: 22px; bottom: 20px; align-items: flex-end; padding: 8px 12px 10px 8px; background-color: rgba(18, 18, 23, 0.7); border-radius: 4px; }
.lb-hint-row { flex-direction: row; align-items: center; margin-top: 5px; }
.lb-hint-row .lb-keycap { height: 20px; min-width: 20px; margin-left: 8px; padding: 0 5px 1px 5px; }
.lb-hint-row .lb-keycap-text { font-size: 13px; }
.lb-hint-text { margin: 0 0 0 5px; padding: 0; font-size: 13px; color: rgba(238, 232, 219, 0.85); }
.lb-healthbars { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lb-unit-bar { position: absolute; width: 40px; height: 6px; margin-left: -20px; border-width: 1px; border-color: rgba(0, 0, 0, 0.85); background-color: rgba(0, 0, 0, 0.6); }
.lb-unit-bar-fill { height: 100%; }
.lb-unit-bar--ally .lb-unit-bar-fill { background-color: rgb(98, 165, 230); }
.lb-unit-bar--enemy .lb-unit-bar-fill { background-color: rgb(214, 80, 80); }

/* ---------- Overlays: pause and result ---------- */

.lb-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 10, 14, 0.62); align-items: center; justify-content: center; }
.lb-flow { background-color: rgba(10, 10, 13, 0.84); color: var(--ivory); }
.lb-flow-dialog {
    width: 860px;
    max-width: 92%;
    max-height: 94%;
    padding: 42px 60px 34px 60px;
    background-image: url("Art/Chrome/Ui_Dialog.png");
    -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-type: tiled;
    align-items: stretch;
}
.lb-flow-eyebrow { font-size: 13px; letter-spacing: 4px; color: var(--gold); -unity-text-align: middle-center; margin-bottom: 8px; }
.lb-flow-title { font-size: 48px; -unity-font-style: bold; color: var(--gold-bright); -unity-text-align: middle-center; margin: 0 0 6px 0; letter-spacing: 8px; text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85); }
.lb-flow-description { font-size: 17px; color: rgb(212, 214, 224); white-space: normal; -unity-text-align: middle-center; margin: 2px 0 18px 0; }
.lb-flow-muted { font-size: 13px; color: var(--muted); white-space: normal; -unity-text-align: middle-center; }
.lb-flow .lb-flow-primary { width: 320px; flex-shrink: 0; align-self: center; margin-top: 20px; }
.lb-flow-footnote { font-size: 13px; color: var(--muted); -unity-text-align: middle-center; margin-top: 14px; }
.lb-title--defeat { color: rgb(232, 146, 132); }

.lb-result--victory { background-color: rgba(10, 8, 4, 0.82); }
.lb-result--defeat { background-color: rgba(14, 4, 6, 0.88); }
.lb-result-rays { position: absolute; left: 50%; top: 50%; width: 1100px; height: 1100px; margin: -550px 0 0 -550px; background-image: url("Art/Chrome/Ui_Rays.png"); -unity-background-scale-mode: stretch-to-fill; opacity: 0.35; }
.lb-result--defeat .lb-result-rays { display: none; }
.lb-result-ember { position: absolute; left: 10%; right: 10%; top: -10%; bottom: 30%; background-image: url("Art/Prep_Glow.png"); -unity-background-image-tint-color: rgb(170, 30, 24); -unity-background-scale-mode: stretch-to-fill; opacity: 0; }
.lb-result--defeat .lb-result-ember { opacity: 0.3; }
.lb-result-stack { align-items: center; max-height: 100%; }
.lb-result-dialog { width: 780px; max-height: 100%; padding-top: 52px; flex-shrink: 1; }
.lb-result-banner { align-self: center; flex-shrink: 0; }
.lb-result-banner .lb-flow-title { margin: 0; font-size: 60px; letter-spacing: 20px; padding-left: 20px; }
.lb-result-subtitle { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 15px; letter-spacing: 14px; color: var(--gold); -unity-text-align: middle-center; margin: 2px 0 2px 14px; }
.lb-result--defeat .lb-result-subtitle { color: rgb(200, 120, 108); }
.lb-result--defeat .lb-flow-title { color: rgb(232, 146, 132); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85); }
.lb-result-reward { flex-direction: row; flex-shrink: 0; align-self: center; align-items: center; padding: 6px 22px 6px 14px; margin-bottom: 16px; border-width: 1px; border-color: var(--gold-dim); border-radius: 22px; background-color: rgba(226, 186, 108, 0.09); }
.lb-result-reward-value { font-size: 19px; -unity-font-style: bold; color: var(--gold-bright); }
.lb-result-summary { flex-direction: row; flex-shrink: 0; margin: 0 0 6px 0; }
.lb-result-metric {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    margin: 0 6px;
    padding: 14px 0 12px 0;
    background-image: url("Art/Chrome/Ui_Card.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-type: tiled;
}
.lb-result-icon { width: 26px; height: 26px; flex-shrink: 0; margin-bottom: 4px; -unity-background-scale-mode: scale-to-fit; }
.lb-result-icon--time { background-image: url("Art/Chrome/Ui_IconWave.png"); }
.lb-result-icon--ally { background-image: url("Art/Chrome/Ui_IconAlly.png"); }
.lb-result-icon--enemy { background-image: url("Art/Chrome/Ui_IconEnemy.png"); }
.lb-result-value { font-size: 28px; -unity-font-style: bold; color: var(--ivory); margin-bottom: 2px; }
.lb-result-details { flex-shrink: 0; margin: 16px 0 4px 0; color: var(--muted); font-size: 14px; }
.lb-result-scroll { max-height: 260px; }
.lb-stats { align-self: stretch; margin: 6px 0 10px 0; }
.lb-stat { font-size: 13px; color: var(--muted); white-space: normal; margin-bottom: 8px; }
.lb-result .lb-caption { color: rgb(220, 208, 178); font-size: 13px; margin-top: 10px; letter-spacing: 0; }
.lb-ratings { flex-direction: row; margin: 4px 0 8px 0; }
.lb-rating { width: 44px; height: 32px; margin: 0 3px; background-color: rgb(30, 30, 36); border-width: 1px; border-color: var(--gold-dim); border-radius: 3px; color: var(--ivory); }
.lb-rating--on { background-color: var(--gold); color: rgb(30, 18, 6); }
.lb-note { align-self: stretch; min-height: 60px; margin-bottom: 10px; }
.lb-result .lb-note .unity-text-field__input { background-color: rgb(20, 20, 25); color: var(--ivory); border-width: 1px; border-color: var(--gold-dim); padding: 10px; }

.lb-pause-dialog { width: 940px; }
.lb-pause-confirm { width: 720px; }
.lb-pause-columns { flex-direction: row; margin-top: 2px; }
.lb-pause-section {
    flex-grow: 1;
    flex-basis: 0;
    padding: 18px 22px;
    background-image: url("Art/Chrome/Ui_Card.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-type: tiled;
}
.lb-pause-section--keys { margin-left: 16px; }
.lb-pause-heading { font-size: 16px; -unity-font-style: bold; letter-spacing: 3px; color: var(--gold-bright); margin-bottom: 14px; }
.lb-pause-volume-header { flex-direction: row; justify-content: space-between; align-items: center; }
.lb-pause-volume-name { font-size: 15px; color: var(--ivory); }
.lb-pause-volume-value { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 15px; color: var(--gold-bright); }
.lb-pause-volume { margin: 8px 0 18px 0; height: 24px; }
.lb-pause-volume .unity-base-field__label { display: none; }
.lb-pause-volume .unity-base-slider__tracker { height: 6px; margin-top: -3px; border-width: 1px; border-color: var(--gold-faint); border-radius: 3px; background-color: rgb(58, 56, 62); }
.lb-pause-volume .unity-base-slider__dragger { width: 18px; height: 18px; margin-top: -7px; border-radius: 9px; background-color: var(--gold-bright); border-width: 2px; border-color: rgb(110, 76, 22); }
.lb-pause-credits { color: var(--muted); font-size: 13px; margin: 0; }
.lb-pause-key-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.lb-pause-keycap { min-width: 112px; height: 28px; margin-right: 14px; }
/* The same plain gold rim as the TAB key under the battle map (two classes so it outranks the shared keycap shadow). */
.lb-keycap.lb-pause-keycap { padding: 0 7px; border-width: 1px; border-color: var(--gold-dim); }
.lb-pause-keycap .lb-keycap-text { font-size: 13px; }
.lb-pause-key-action { font-size: 14px; color: var(--ivory); }
.lb-pause-actions { flex-direction: row; justify-content: center; align-items: center; margin-top: 24px; }
.lb-pause-actions .lb-flow-primary { width: 280px; margin: 0 0 0 16px; }
.lb-pause-end {
    width: 240px;
    height: 48px;
    margin: 0;
    flex-shrink: 0;
    padding: 0 0 1px 0;
    background-image: url("Art/Chrome/Ui_BtnDanger.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 23; -unity-slice-bottom: 23;
    -unity-background-image-tint-color: rgb(228, 228, 228);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 210, 196);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.lb-pause-end:hover, .lb-pause-end:focus, .lb-pause-end:active { -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); color: rgb(255, 232, 222); }

/* ---------- Level-up blessings ---------- */

.lb-levelup { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; align-items: center; justify-content: center; color: var(--ivory); background-color: rgb(16, 16, 21); }
.lb-levelup-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("Art/Prep_Glow.png"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(120, 90, 40); opacity: 0.35; }
.lb-levelup-header { align-items: center; margin-bottom: 30px; }
.lb-levelup-rule { width: 520px; margin: 4px 0 6px 0; }
.lb-levelup-title-row { flex-direction: row; align-items: center; }
.lb-levelup-title { margin: 0 0 6px 0; padding: 0; font-size: 46px; letter-spacing: 8px; color: var(--gold-bright); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85); }
.lb-levelup-subtitle { margin: 4px 0 0 0; padding: 0; font-size: 16px; color: var(--muted); }
.lb-levelup-remaining { margin: 10px 0 0 0; padding: 4px 14px; font-size: 13px; -unity-font-style: bold; border-width: 1px; border-color: var(--gold-dim); border-radius: 12px; background-color: rgba(226, 186, 108, 0.08); color: var(--gold-bright); }
.lb-lvcards { flex-direction: row; justify-content: center; width: 86%; max-width: 1240px; }
.lb-lvslot { flex-grow: 1; flex-basis: 0; margin: 0 12px; }
.lb-lvcard {
    width: 100%;
    height: 470px;
    margin: 0;
    padding: 34px 32px 26px 32px;
    align-items: flex-start;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Art/Chrome/Ui_Card.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-type: tiled;
    border-width: 0;
    color: var(--ivory);
    transition-property: translate, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.lb-lvcard:hover, .lb-lvcard:focus { translate: 0 -6px; background-color: rgba(0, 0, 0, 0); }
.lb-lvcard:active { translate: 0 -2px; background-color: rgba(0, 0, 0, 0); }
.lb-lvcard--selected, .lb-lvcard--selected:hover { translate: 0 -10px; background-image: url("Art/Chrome/Ui_CardActive.png"); }
.lb-lvcard--dimmed { opacity: 0.6; }
.lb-lvcard--dimmed:hover { opacity: 0.9; }
.lb-lvcard-medal { position: absolute; right: 22px; top: 22px; width: 34px; height: 34px; border-radius: 17px; border-width: 1px; border-color: var(--gold-dim); background-color: rgb(30, 30, 36); align-items: center; justify-content: center; }
.lb-lvcard--selected .lb-lvcard-medal { background-color: var(--gold); border-color: var(--gold-bright); }
.lb-lvcard-number { margin: 0; padding: 0; font-size: 14px; color: var(--ivory); -unity-text-align: middle-center; }
.lb-lvcard--selected .lb-lvcard-number { color: rgb(30, 18, 6); }
.lb-lvcard-category { margin: 0; padding: 0; font-size: 13px; letter-spacing: 3px; -unity-font-style: bold; color: var(--muted); }
.lb-lvcard-well { width: 108px; height: 108px; margin: 18px 0 10px 0; align-items: center; justify-content: center; background-image: url("Art/Chrome/Ui_Socket.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-growth-icon { width: 76px; height: 76px; background-size: contain; }
.lb-growth-icon--AuraSize { background-image: url("Art/Growth_AuraSize.png"); }
.lb-growth-icon--FoodProduction { background-image: url("Art/Growth_FoodProduction.png"); }
.lb-growth-icon--ManaRecovery { background-image: url("Art/Growth_ManaRecovery.png"); }
.lb-growth-icon--Capacity { background-image: url("Art/Growth_Capacity.png"); }
.lb-growth-icon--Leadership { background-image: url("Art/Growth_Leadership.png"); }
.lb-growth-icon--AuraBuff { background-image: url("Art/Growth_AuraBuff.png"); }
.lb-growth-icon--HeroPower { background-image: url("Art/Growth_HeroPower.png"); }
.lb-growth-icon--HeroVitality { background-image: url("Art/Growth_HeroVitality.png"); }
.lb-lvcard-title { margin: 4px 0 14px 0; padding: 0; font-size: 26px; -unity-font-style: bold; color: var(--ivory); -unity-text-align: middle-left; white-space: normal; }
.lb-lvcard-description { min-height: 54px; margin: 0; padding: 0; font-size: 16px; color: var(--muted); -unity-text-align: upper-left; white-space: normal; }
.lb-lvcard-effect { margin: 16px 0 0 0; padding: 0; font-size: 22px; color: var(--gold-bright); -unity-text-align: middle-left; }
.lb-lvcard-footer { position: absolute; left: 32px; right: 32px; bottom: 22px; height: 60px; padding: 12px 0 0 0; flex-direction: column; align-items: flex-start; border-top-width: 1px; border-color: var(--gold-faint); }
.lb-lvcard-rank { margin: 0 0 5px 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: var(--muted); }
.lb-lvcard-total { margin: 0; padding: 0; font-size: 14px; -unity-font-style: bold; color: var(--ivory); white-space: normal; }
.lb-lvcard--aura .lb-lvcard-category, .lb-lvcard--aura .lb-lvcard-effect { color: rgb(236, 196, 132); }
.lb-lvcard--supply .lb-lvcard-category, .lb-lvcard--supply .lb-lvcard-effect { color: rgb(172, 198, 128); }
.lb-lvcard--magic .lb-lvcard-category, .lb-lvcard--magic .lb-lvcard-effect { color: rgb(152, 174, 214); }
.lb-lvcard--command .lb-lvcard-category, .lb-lvcard--command .lb-lvcard-effect { color: rgb(180, 160, 210); }
.lb-lvcard--hero .lb-lvcard-category, .lb-lvcard--hero .lb-lvcard-effect { color: rgb(216, 134, 118); }
.lb-levelup-prompt { align-items: center; margin-top: 26px; }
.lb-levelup-prompt-hint { margin: 6px 0 0 0; padding: 0; font-size: 14px; color: var(--muted); }
.lb-levelup-confirm { width: 320px; margin-top: 14px; }

/* ---------- Preparation: mission briefing and hero equipment ---------- */

.lb-brief { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(16, 16, 21); color: var(--ivory); }
.lb-brief-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("Art/CampaignAtlas_Act1_v1.png"); -unity-background-scale-mode: scale-and-crop; opacity: 0.12; }
.lb-brief--act2 .lb-brief-background, .lb-brief--act2 .lb-brief-landscape { background-image: url("Art/CampaignAtlas_Act2_v2.png"); }
.lb-brief--act3 .lb-brief-background, .lb-brief--act3 .lb-brief-landscape { background-image: url("Art/CampaignAtlas_Act3_v2.png"); }
.lb-brief-vignette { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("Art/Prep_Fade.png"); background-size: 100% 100%; opacity: 0.8; }

.lb-brief-header, .lb-upg-header { flex-direction: row; align-items: center; height: 64px; }
.lb-brief-header { position: absolute; left: 48px; right: 48px; top: 26px; }
.lb-brief-heading-block, .lb-upg-heading-block { flex-grow: 1; margin-left: 24px; padding-left: 24px; border-left-width: 1px; border-left-color: var(--gold-faint); }
.lb-brief-eyebrow, .lb-upg-eyebrow { font-size: 13px; letter-spacing: 4px; color: var(--gold); margin: 0; padding: 0; -unity-font-style: bold; }
.lb-brief-title, .lb-upg-heading { font-size: 30px; -unity-font-style: bold; letter-spacing: 1px; margin: 4px 0 0 0; padding: 0; color: var(--ivory); }
.lb-brief-actions, .lb-upg-header-right { flex-direction: row; align-items: center; }
.lb-upg-purse { flex-direction: row; align-items: center; height: 46px; padding: 0 22px 0 14px; background-color: rgba(18, 18, 23, 0.9); border-width: 1px; border-color: var(--gold-dim); border-radius: 23px; }
.lb-upg-gold { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 21px; color: var(--gold-bright); }
.lb-brief-body { position: absolute; left: 48px; right: 48px; top: 112px; bottom: 100px; flex-direction: row; }
.lb-brief .unity-scroll-view__content-container { flex-shrink: 0; }
.lb-brief-mission, .lb-brief-armory {
    background-image: url("Art/Chrome/Ui_Panel.png");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-type: tiled;
    padding: 22px 26px;
}
.lb-brief-mission { width: 34%; margin-right: 20px; align-self: flex-start; max-height: 100%; }
.lb-brief-armory { flex-grow: 1; flex-basis: 0; }

.lb-brief-landscape {
    height: 236px;
    flex-shrink: 0;
    justify-content: flex-end;
    padding: 16px 20px;
    background-image: url("Art/CampaignAtlas_Act1_v1.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: var(--gold-faint);
}
.lb-brief-destination { font-size: 42px; -unity-font-style: bold; color: var(--ivory); margin: 2px 0 4px 0; padding: 0; text-shadow: 0 2px 10px rgb(0, 0, 0); }
.lb-brief-tag { font-size: 14px; -unity-font-style: bold; color: rgb(255, 172, 150); margin: 0; padding: 0; text-shadow: 0 1px 4px rgb(0, 0, 0); }
.lb-brief-landscape--cleared .lb-brief-tag { color: var(--gold-bright); }
.lb-brief-section-row { flex-direction: row; align-items: center; margin: 22px 0 12px 0; }
.lb-brief-section-mark { width: 7px; height: 7px; margin: 0 10px 0 1px; rotate: 45deg; background-color: var(--gold); }
.lb-brief-section { font-size: 15px; letter-spacing: 2px; -unity-font-style: bold; color: var(--gold-bright); margin: 0; padding: 0; }
.lb-brief-section-line { flex-grow: 1; height: 1px; margin-left: 14px; background-color: var(--gold-faint); }
.lb-brief-objective { font-size: 18px; color: var(--ivory); white-space: normal; margin: 0; padding: 0; }
.lb-brief-metrics { flex-direction: row; margin: 16px 0 0 0; }
.lb-brief-metric, .lb-brief-reward, .lb-brief-slot, .lb-brief-item, .lb-brief-inspect, .lb-upg-tile, .lb-upg-buy {
    background-image: url("Art/Chrome/Ui_Card.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-type: tiled;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}
.lb-brief-metric { flex-grow: 1; flex-basis: 0; margin-right: 10px; padding: 12px 16px; }
.lb-brief-metric .lb-brief-muted { margin: 0; }
.lb-brief-metric-value { font-size: 26px; -unity-font-style: bold; color: var(--gold-bright); margin: 2px 0 0 0; padding: 0; }
.lb-brief-enemies { flex-direction: row; flex-wrap: wrap; }
.lb-brief-enemy { font-size: 14px; color: rgb(250, 212, 202); margin: 0 8px 8px 0; padding: 5px 14px 6px 14px; background-color: rgba(150, 40, 30, 0.22); border-width: 1px; border-color: rgba(226, 110, 90, 0.42); border-radius: 14px; }
.lb-brief-reward { flex-direction: row; align-items: center; min-height: 72px; padding: 12px 16px; }
.lb-brief-reward .lb-icon { width: 46px; height: 46px; margin-right: 14px; }
.lb-brief-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.lb-brief-muted { font-size: 13px; color: var(--muted); white-space: normal; margin: 3px 0 0 0; padding: 0; -unity-text-align: middle-left; }
.lb-brief-item-name { font-size: 17px; -unity-font-style: bold; color: var(--ivory); white-space: normal; margin: 0; padding: 0; -unity-text-align: middle-left; }

.lb-brief-identity { flex-direction: row; align-items: center; padding: 0 0 18px 0; border-bottom-width: 1px; border-bottom-color: var(--gold-faint); }
.lb-brief-level { width: 72px; height: 72px; flex-shrink: 0; margin-right: 18px; align-items: center; justify-content: center; background-image: url("Art/Chrome/Ui_Medallion.png"); -unity-background-scale-mode: scale-to-fit; background-color: rgb(22, 22, 28); border-radius: 36px; }
.lb-brief-level-value { font-size: 26px; -unity-font-style: bold; color: var(--gold-bright); margin: 0; padding: 0; }
.lb-brief-hero-name { font-size: 20px; -unity-font-style: bold; color: var(--ivory); margin: 0; padding: 0; }
.lb-brief-xp { height: 10px; margin: 8px 30px 2px 0; background-color: rgb(14, 14, 18); border-width: 1px; border-color: var(--gold-dim); border-radius: 5px; overflow: hidden; }
.lb-brief-xp-fill { height: 100%; width: 0; background-image: url("Art/Chrome/Ui_Gloss.png"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(214, 164, 86); }

.lb-brief-slots { flex-direction: row; }
.lb-brief-slot { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; height: 100px; margin: 0 10px 0 0; padding: 10px 14px; transition-property: translate; transition-duration: 0.14s; }
.lb-brief-slot:hover, .lb-brief-slot:focus, .lb-brief-item:hover, .lb-brief-item:focus, .lb-upg-tile:hover, .lb-upg-tile:focus { -unity-background-image-tint-color: rgb(255, 236, 200); background-color: rgba(0, 0, 0, 0); }
.lb-brief-slot--active, .lb-brief-slot--active:hover, .lb-brief-item--selected, .lb-brief-item--selected:hover, .lb-upg-tile--selected, .lb-upg-tile--selected:hover { background-image: url("Art/Chrome/Ui_CardActive.png"); -unity-background-image-tint-color: rgb(255, 255, 255); }
.lb-brief-socket { width: 70px; height: 70px; flex-shrink: 0; margin-right: 14px; align-items: center; justify-content: center; }
.lb-brief-socket .lb-icon { width: 50px; height: 50px; border-radius: 25px; background-color: rgb(20, 20, 25); background-size: cover; }
.lb-brief-socket-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("Art/Chrome/Ui_Socket.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-brief-key { align-self: flex-start; margin: 0 0 4px 0; padding: 1px 7px 2px 7px; font-size: 13px; -unity-font-style: bold; color: var(--gold-bright); background-color: rgb(30, 30, 36); border-width: 1px 1px 2px 1px; border-color: var(--gold-dim); border-radius: 3px; }
.lb-brief-slot .lb-brief-item-name { white-space: nowrap; }

.lb-brief-inventory-hint { font-size: 13px; color: var(--muted); margin: -4px 0 12px 0; padding: 0; }
.lb-brief-library { flex-direction: row; align-items: flex-start; }
.lb-brief-inventory { width: 42%; flex-shrink: 0; }
.lb-brief-item { flex-direction: row; align-items: center; height: 76px; margin: 0 0 8px 0; padding: 8px 16px; }
.lb-brief-item .lb-icon { width: 48px; height: 48px; flex-shrink: 0; margin-right: 14px; border-radius: 24px; border-width: 2px; border-color: var(--gold-dim); background-color: rgb(20, 20, 25); background-size: cover; }
.lb-brief-item--selected .lb-icon { border-color: var(--gold-bright); }
.lb-brief-item--equipped .lb-brief-muted { color: var(--gold); }
.lb-brief-item:disabled { opacity: 0.4; }
.lb-brief-inspect { flex-grow: 1; margin-left: 16px; padding: 20px 22px; }
.lb-brief-inspect-top { flex-direction: row; align-items: center; }
.lb-brief-detail-socket { width: 88px; height: 88px; flex-shrink: 0; margin-right: 18px; align-items: center; justify-content: center; background-image: url("Art/Chrome/Ui_Socket.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-brief-inspect .lb-brief-detail-icon { width: 64px; height: 64px; border-radius: 32px; background-color: rgb(20, 20, 25); background-size: cover; }
.lb-brief-item-title { font-size: 25px; -unity-font-style: bold; color: var(--gold-bright); margin: 4px 0 0 0; padding: 0; }
.lb-brief-item-stats { font-size: 14px; color: rgb(150, 172, 206); margin: 16px 0 0 0; padding: 10px 0 0 0; border-top-width: 1px; border-top-color: var(--gold-faint); }
.lb-brief-effect { font-size: 16px; color: var(--ivory); white-space: normal; margin: 10px 0 0 0; padding: 0; }
.lb-brief-shards { font-size: 13px; color: var(--muted); margin: 14px 0 10px 0; }
.lb-brief-inspect-actions { flex-direction: row; align-items: center; }
.lb-brief-equip { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.lb-brief-feedback { height: 24px; margin: 8px 0 0 0; padding: 0; font-size: 14px; color: rgb(168, 200, 132); }

.lb-brief-footer { position: absolute; left: 48px; right: 48px; bottom: 22px; height: 64px; flex-direction: row; align-items: center; justify-content: space-between; }
.lb-brief-status { flex-shrink: 1; margin-right: 30px; font-size: 14px; }
.lb-brief .lb-brief-start { width: 380px; flex-shrink: 0; }
.lb-brief-growth-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(10, 10, 13, 0.88); align-items: center; justify-content: center; }
.lb-brief-growth-dialog {
    width: 680px;
    max-height: 78%;
    padding: 34px 42px;
    background-image: url("Art/Chrome/Ui_Dialog.png");
    -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-type: tiled;
}
.lb-brief-heading-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.lb-brief-heading { font-size: 24px; -unity-font-style: bold; color: var(--gold-bright); margin: 0; padding: 0; }
.lb-brief-growth-list { margin-top: 4px; flex-shrink: 1; }
.lb-brief-growth-row { font-size: 16px; white-space: normal; color: var(--ivory); padding: 14px 0; border-bottom-width: 1px; border-bottom-color: var(--gold-faint); }

/* ---------- Troops: light shard upgrades ---------- */

.lb-upg { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-upg-dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(16, 16, 21); }
.lb-upg-dialog { position: absolute; left: 48px; right: 48px; top: 26px; bottom: 22px; }
.lb-upg-body { flex-direction: row; flex-grow: 1; flex-shrink: 1; margin-top: 22px; }
.lb-upg-roster { width: 52%; }
.lb-upg-caption { font-size: 14px; color: var(--muted); margin-bottom: 12px; }
.lb-upg-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.lb-upg-tile { width: 24%; height: 404px; margin: 0 1% 12px 0; padding: 0; overflow: hidden; }
.lb-upg-tile--locked { opacity: 0.4; }
.lb-upg-tile--locked .lb-upg-art { -unity-background-image-tint-color: rgb(60, 66, 84); }
.lb-upg-art { position: absolute; left: 4px; right: 4px; top: 4px; bottom: 34px; background-size: cover; background-position-y: top; }
.lb-upg-tile-shade { position: absolute; left: 4px; right: 4px; bottom: 34px; height: 46%; background-image: url("Art/Prep_Fade.png"); background-size: 100% 100%; }
.lb-upg-tile-glow { position: absolute; left: -10%; right: -10%; top: 0; bottom: 34px; background-image: url("Art/Prep_Glow.png"); -unity-background-scale-mode: stretch-to-fill; opacity: 0.38; }
.lb-upg-tile--selected .lb-upg-tile-glow { opacity: 0.85; }
.lb-upg-tile--locked .lb-upg-tile-glow { opacity: 0; }
/* Upgrade level bands: untrained, green, blue, violet, maximum gold. */
.lb-upg-level--0 .lb-upg-tile-glow { -unity-background-image-tint-color: rgb(110, 118, 132); }
.lb-upg-level--1 .lb-upg-tile-glow, .lb-upg-level--2 .lb-upg-tile-glow, .lb-upg-level--3 .lb-upg-tile-glow { -unity-background-image-tint-color: rgb(126, 155, 116); }
.lb-upg-level--4 .lb-upg-tile-glow, .lb-upg-level--5 .lb-upg-tile-glow, .lb-upg-level--6 .lb-upg-tile-glow { -unity-background-image-tint-color: rgb(112, 143, 180); }
.lb-upg-level--7 .lb-upg-tile-glow, .lb-upg-level--8 .lb-upg-tile-glow, .lb-upg-level--9 .lb-upg-tile-glow { -unity-background-image-tint-color: rgb(156, 127, 174); }
.lb-upg-level--10 .lb-upg-tile-glow { -unity-background-image-tint-color: rgb(220, 176, 116); }
.lb-upg-tile-key { position: absolute; top: 10px; right: 10px; width: 24px; height: 24px; padding: 0; -unity-text-align: middle-center; font-size: 13px; -unity-font-style: bold; color: var(--ivory); background-color: rgb(30, 30, 36); border-width: 1px 1px 2px 1px; border-color: var(--gold-dim); border-radius: 4px; }
.lb-upg-tile-price { position: absolute; left: 10px; top: 10px; flex-direction: row; align-items: center; padding: 2px 10px 2px 6px; background-color: rgba(14, 14, 18, 0.86); border-width: 1px; border-color: var(--gold-dim); border-radius: 11px; }
.lb-upg-food { width: 16px; height: 16px; margin-right: 4px; background-image: url("Art/Growth_FoodProduction.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-upg-tile-cost { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 14px; color: var(--gold-bright); }
.lb-upg-tile-name { position: absolute; left: 0; right: 0; bottom: 40px; font-size: 19px; -unity-font-style: bold; color: var(--ivory); -unity-text-align: middle-center; text-shadow: 0 2px 4px rgb(0, 0, 0); }
.lb-upg-tile-rank { position: absolute; left: 4px; right: 4px; bottom: 4px; height: 30px; -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 15px; color: var(--gold); -unity-text-align: middle-center; border-top-width: 1px; border-color: var(--gold-faint); }
.lb-upg-tile--maxed .lb-upg-tile-rank { color: rgb(255, 236, 160); }
.lb-upg-icon--0 { background-image: url("Art/UnitIcon_Swordsman.png"); }
.lb-upg-icon--1 { background-image: url("Art/UnitIcon_Archer.png"); }
.lb-upg-icon--2 { background-image: url("Art/UnitIcon_Shieldbearer.png"); }
.lb-upg-icon--3 { background-image: url("Art/UnitIcon_Spearman.png"); }
.lb-upg-icon--4 { background-image: url("Art/UnitIcon_Priest.png"); }
.lb-upg-icon--5 { background-image: url("Art/UnitIcon_Mage.png"); }
.lb-upg-icon--6 { background-image: url("Art/UnitIcon_Knight.png"); }
.lb-upg-icon--7 { background-image: url("Art/UnitIcon_Dragon.png"); }
.lb-upg-art--0 { background-image: url("Art/Unit_Swordsman.png"); }
.lb-upg-art--1 { background-image: url("Art/Unit_Archer.png"); }
.lb-upg-art--2 { background-image: url("Art/Unit_Shieldbearer.png"); }
.lb-upg-art--3 { background-image: url("Art/Unit_Spearman.png"); }
.lb-upg-art--4 { background-image: url("Art/Unit_Priest.png"); }
.lb-upg-art--5 { background-image: url("Art/Unit_Mage.png"); }
.lb-upg-art--6 { background-image: url("Art/Unit_Knight.png"); }
.lb-upg-art--7 { background-image: url("Art/Unit_Dragon.png"); }
.lb-upg-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 18px;
    flex-direction: row;
    padding: 24px 28px;
    background-image: url("Art/Chrome/Ui_Panel.png");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-type: tiled;
}
.lb-upg-stage { width: 38%; flex-shrink: 0; }
.lb-upg-glow { position: absolute; left: -10%; right: -10%; top: 10%; bottom: 10%; background-image: url("Art/Prep_Glow.png"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(110, 140, 220); opacity: 0.35; }
.lb-upg-portrait { position: absolute; left: 0; right: 0; top: 8px; bottom: 8px; -unity-background-scale-mode: scale-to-fit; }
.lb-upg-info { flex-grow: 1; flex-basis: 0; margin-left: 24px; }
.lb-upg-identity { padding-bottom: 14px; border-bottom-width: 1px; border-bottom-color: var(--gold-faint); }
.lb-upg-name { font-size: 36px; -unity-font-style: bold; color: var(--ivory); letter-spacing: 2px; }
.lb-upg-rank { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 15px; letter-spacing: 2px; color: var(--gold); margin-top: 6px; }
.lb-upg-pips { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.lb-upg-pip { width: 11px; height: 11px; margin: 0 9px 6px 1px; rotate: 45deg; background-color: rgb(30, 30, 36); border-width: 1px; border-color: var(--gold-dim); }
.lb-upg-pip--on { background-color: var(--gold-bright); border-color: rgb(255, 248, 220); }
.lb-upg-role { margin: 14px 0 12px 0; font-size: 15px; color: var(--muted); white-space: normal; min-height: 40px; }
.lb-upg-stats { padding: 10px 0; border-top-width: 1px; border-bottom-width: 1px; border-color: var(--gold-faint); }
.lb-upg-stat { flex-direction: row; align-items: center; padding: 4px 0; }
.lb-upg-stat-name { width: 84px; font-size: 15px; color: var(--muted); }
.lb-upg-stat-now { width: 84px; -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 24px; color: var(--ivory); }
.lb-upg-arrow { width: 30px; font-size: 22px; color: var(--gold); -unity-text-align: middle-center; }
.lb-upg-stat-next { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 24px; color: rgb(168, 200, 132); }
.lb-upg-meters { margin-top: 12px; }
.lb-upg-meter { flex-direction: row; align-items: center; padding: 5px 0; }
.lb-upg-meter-name { width: 64px; font-size: 14px; color: var(--muted); }
.lb-upg-track { flex-grow: 1; height: 10px; background-color: rgb(14, 14, 18); border-width: 1px; border-color: var(--gold-dim); border-radius: 5px; overflow: hidden; }
.lb-upg-fill { height: 100%; background-image: url("Art/Chrome/Ui_Gloss.png"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(214, 164, 86); }
.lb-upg-buy { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 20px; padding: 14px 16px 14px 20px; }
.lb-upg-cost { flex-direction: row; align-items: center; }
.lb-upg-cost-caption { font-size: 13px; color: var(--muted); margin-right: 10px; }
.lb-upg-cost-value { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 28px; color: var(--gold-bright); }
.lb-upg-cost--short .lb-upg-cost-value { color: rgb(236, 112, 118); }
.lb-upg-button { width: 230px; }
.lb-upg-feedback { margin-top: 10px; font-size: 14px; color: rgb(168, 200, 132); min-height: 18px; }
.lb-upg-footer { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 16px; height: 64px; }
.lb-upg-footer-note { font-size: 14px; color: var(--muted); }
.lb-upg-start { width: 380px; }

/* Pressed states keep their own surfaces instead of the default theme grey. */
.lb-brief-slot:active, .lb-brief-item:active, .lb-upg-tile:active { background-color: rgba(0, 0, 0, 0); }
.lb-rating:hover { background-color: rgb(44, 42, 48); border-color: var(--gold); }
.lb-rating--on:hover { background-color: var(--gold-bright); }
.lb-title-start:active { background-color: rgba(250, 226, 160, 0.3); }
.lb-title-link:active { background-color: rgba(0, 0, 0, 0); }
.lb-beacon:active { background-color: rgba(0, 0, 0, 0); }

/* ---------- Title ---------- */

.lb-title { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; background-color: rgb(8, 12, 21); background-image: url("../Art/UI/MainMenu/Title_LastLight_Storybook_v2.png"); -unity-background-scale-mode: scale-and-crop; }
.lb-title-brand { position: absolute; left: 6%; top: 19%; width: 36%; height: 25%; max-width: 720px; }
.lb-title-eyebrow { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 13px; letter-spacing: 9px; color: rgba(168, 190, 222, 0.78); }
.lb-title-logo { width: 100%; height: 100%; background-image: url("../Art/UI/MainMenu/Lightbringer_Storybook_Logo_v1.png"); -unity-background-scale-mode: scale-to-fit; }
.lb-title-rule { width: 420px; height: 1px; margin-top: 12px; background-color: rgba(250, 226, 160, 0.55); }
.lb-title-tagline { font-size: 18px; letter-spacing: 4px; color: rgba(214, 220, 232, 0.82); margin-top: 24px; }
.lb-title-menu { position: absolute; left: 8%; bottom: 14%; width: 320px; }
.lb-title-start { height: 58px; font-size: 20px; letter-spacing: 8px; margin: 0 0 22px 0; background-image: none; background-color: rgba(250, 226, 160, 0.08); border-width: 1px; border-color: rgba(250, 226, 160, 0.55); border-radius: 2px; color: rgb(252, 244, 220); -unity-text-align: middle-left; padding-left: 20px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-font-style: normal; }
.lb-title-start:hover, .lb-title-start:focus { background-color: rgba(250, 226, 160, 0.22); border-color: rgb(255, 236, 184); scale: 1 1; }
.lb-title-link { height: 40px; margin: 0 0 4px 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; color: rgba(190, 202, 222, 0.7); font-size: 15px; letter-spacing: 6px; -unity-text-align: middle-left; padding-left: 20px; }
.lb-title-link:hover, .lb-title-link:focus { color: rgb(255, 240, 200); background-color: rgba(0, 0, 0, 0); }
.lb-title-footer { position: absolute; left: 8%; bottom: 4%; font-size: 13px; letter-spacing: 2px; color: rgb(120, 134, 142); }
.lb-upg-tile--locked .lb-upg-tile-price { display: none; }
.lb-brief-landscape .lb-brief-eyebrow { text-shadow: 0 1px 4px rgb(0, 0, 0); }

/* ---------- Storybook type and shapes (last, so they win over the per-screen rules above) ---------- */

/* Display titles in Song Myung: one weight, so never faux-bold it. */
.lb-flow-title, .lb-levelup-title, .lb-brief-title, .lb-upg-heading, .lb-brief-destination, .lb-upg-name,
.lb-atlas-title, .lb-atlas-selected, .lb-brief-heading, .lb-brief-item-title, .lb-pause-heading {
    -unity-font-definition: url("Fonts/SongMyung.asset");
    -unity-font-style: normal;
}

/* Ruled tags instead of glossy pills. */
.lb-upg-purse, .lb-minimap-route, .lb-brief-enemy, .lb-upg-tile-price, .lb-levelup-remaining,
.lb-result-reward, .lb-slot-caption, .lb-hints { border-radius: 2px; }
.lb-keycap, .lb-brief-key, .lb-upg-tile-key, .lb-rating { border-radius: 2px; border-bottom-color: rgba(0, 0, 0, 0.6); }
.lb-result-reward { border-color: var(--gold-faint); background-color: rgba(220, 176, 116, 0.07); }

/* Scrollers only appear on short screens: a thin ruled track with a faded-gold thumb, no arrow buttons. */
.unity-scroller--vertical { width: 10px; margin-left: 6px; }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0.25); border-width: 0 1px; border-color: rgba(181, 150, 114, 0.2); }
.unity-scroller--vertical .unity-base-slider__dragger { left: 2px; width: 6px; background-color: rgba(181, 150, 114, 0.6); border-width: 0; border-radius: 1px; }
.unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }

/* Title menu: the start button is the primary ribbon, the links are quiet ruled lines beneath it. */
.lb-title-start {
    height: 56px;
    padding: 0 36px 2px 36px;
    background-image: url("Art/Chrome/Ui_BtnPrimary.png");
    -unity-slice-left: 30; -unity-slice-right: 30; -unity-slice-top: 27; -unity-slice-bottom: 27;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--gold-bright);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
    -unity-background-image-tint-color: rgb(228, 228, 228);
}
.lb-title-start:hover, .lb-title-start:focus { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); color: rgb(255, 240, 206); }
.lb-title-start:active { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(180, 180, 180); }
.lb-title-link { -unity-text-align: middle-center; padding-left: 0; border-bottom-width: 1px; border-color: rgba(0, 0, 0, 0); margin: 0 60px 4px 60px; color: rgba(214, 204, 184, 0.75); }
.lb-title-link:hover, .lb-title-link:focus { border-color: rgba(220, 176, 116, 0.6); }

/* ---------- Small-type legibility ---------- */
/* Small copy has a 13px floor; keep the larger Song Myung display headings. Gowun Batang's weight table
   supplies the real Bold face for small copy; reduce tracking rather than increasing its footprint. */
.lb-caption, .lb-boss-dialogue-count, .lb-prologue-progress, .lb-prologue-button, .lb-prologue-credits,
.lb-atlas-subtitle, .lb-atlas-progress, .lb-atlas-eyebrow, .lb-atlas-description, .lb-atlas-hint, .lb-atlas-status,
.lb-beacon-name, .lb-beacon-state, .lb-route-caption, .lb-path-hint, .lb-front-number,
.lb-level-value, .lb-hero-name, .lb-hint-text,
.lb-flow-eyebrow, .lb-flow-muted, .lb-flow-footnote, .lb-result-details, .lb-stat,
.lb-pause-volume-name, .lb-pause-credits, .lb-pause-key-action,
.lb-levelup-subtitle, .lb-levelup-prompt-hint, .lb-lvcard-number, .lb-lvcard-category,
.lb-lvcard-description, .lb-lvcard-rank, .lb-lvcard-total,
.lb-brief-eyebrow, .lb-upg-eyebrow, .lb-brief-enemy, .lb-brief-muted,
.lb-brief-inventory-hint, .lb-brief-item-stats, .lb-brief-effect, .lb-brief-shards,
.lb-brief-feedback, .lb-brief-status, .lb-brief-growth-row,
.lb-upg-caption, .lb-upg-role, .lb-upg-stat-name, .lb-upg-meter-name, .lb-upg-cost-caption,
.lb-upg-feedback, .lb-upg-footer-note, .lb-title-link, .lb-title-footer {
    -unity-font-style: bold;
    letter-spacing: 0;
}

/* A little tracking still gives chapter labels their printed-book character. */
.lb-atlas-eyebrow, .lb-flow-eyebrow, .lb-brief-eyebrow, .lb-upg-eyebrow,
.lb-lvcard-category, .lb-title-link { letter-spacing: 1px; }

/* Text over paintings needs a tight ink shadow rather than a broad blurry glow. */
.lb-atlas-subtitle, .lb-atlas-progress, .lb-atlas-status, .lb-beacon-name, .lb-beacon-state,
.lb-prologue-progress, .lb-prologue-button, .lb-title-link, .lb-title-footer,
.lb-brief-status, .lb-upg-footer-note {
    text-shadow: 0 1px 2px rgba(8, 9, 13, 0.95);
}
.lb-atlas-subtitle, .lb-atlas-progress, .lb-atlas-hint, .lb-prologue-progress,
.lb-prologue-button, .lb-title-footer { color: var(--muted); }
.lb-title-link, .lb-hint-text { color: var(--ivory); }
.lb-atlas-eyebrow, .lb-atlas-status, .lb-flow-eyebrow, .lb-brief-eyebrow, .lb-upg-eyebrow,
.lb-beacon--lit .lb-beacon-name, .lb-beacon--lit .lb-beacon-state,
.lb-brief-item--equipped .lb-brief-muted { color: var(--gold-text); }
.lb-beacon-state { background-color: rgba(14, 15, 20, 0.66); border-radius: 2px; padding: 1px 5px; }
.lb-brief-item-stats, .lb-cost { color: rgb(186, 204, 228); }
.lb-card-name, .lb-card-cost { color: var(--muted); }

/* Locked content must still explain itself. Dim the art instead of its name and state label. */
.lb-beacon:disabled, .lb-brief-item:disabled, .lb-upg-tile--locked { opacity: 1; }
.lb-beacon:disabled .lb-beacon-symbol { opacity: 0.85; }
.lb-brief-item:disabled .lb-icon { opacity: 0.45; }
.lb-brief-item:disabled .lb-brief-item-name,
.lb-upg-tile--locked .lb-upg-tile-name, .lb-upg-tile--locked .lb-upg-tile-rank { color: var(--muted); }
.lb-atlas-primary:disabled, .lb-button:disabled, .lb-prologue-button:disabled { opacity: 0.65; }
